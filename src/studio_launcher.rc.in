// Ressourcen des GBX-Studio-Startprogramms (Icon und Versionsangaben).
// CMake ersetzt den Pfad zum Icon beim Konfigurieren.

#define IDI_APPICON 101

IDI_APPICON ICON "@CMAKE_SOURCE_DIR@/ide/assets/icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "FileDescription", "GBX Studio - Editor"
            VALUE "FileVersion", "1.0.1"
            VALUE "InternalName", "GBXStudio"
            VALUE "LegalCopyright", "GameBasiX"
            VALUE "OriginalFilename", "GBXStudio.exe"
            VALUE "ProductName", "GBX Studio"
            VALUE "ProductVersion", "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
