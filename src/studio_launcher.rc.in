// Ressourcen des GBX-Studio-Startprogramms (Icon und Versionsangaben).
// CMake ersetzt den Pfad zum Icon beim Konfigurieren.

#define IDI_APPICON 101

IDI_APPICON ICON "@CMAKE_SOURCE_DIR@/ide/assets/icon.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "FileDescription", "@GBX_STUDIO_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@GBX_STUDIO_INTERNAL_NAME@"
            VALUE "LegalCopyright", "GameBasiX"
            VALUE "OriginalFilename", "@GBX_STUDIO_ORIGINAL_NAME@"
            VALUE "ProductName", "GBX Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
