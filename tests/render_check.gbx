' Renderpruefung: zeichnet bekannte Formen und speichert den Bildschirm.
' Aufruf: SDL_VIDEODRIVER=dummy gbx tests/render_check.gbx

SCREEN_SET 320, 240, 0
SCREEN_CLEAR RGB(0, 0, 64)

DRAW_RECT 10, 10, 100, 50, RGB(255, 0, 0)
DRAW_LINE 0, 0, 319, 0, RGB(0, 255, 0)
DRAW_CIRCLE_FILLED 160, 130, 30, RGB(0, 128, 255)
DRAW_RECT_BORDER 200, 10, 100, 60, RGB(255, 255, 0)

' Sprite laden und zeichnen (Pfad relativ zur Projektdatei)
SPRITE_LOAD "../examples/03_sprites/assets/ball.png", 0
SPRITE_DRAW 0, 230, 150

' TTF, falls vorhanden
fontHeight = 0
TRY
  FONT_LOAD "arial.ttf", 2, 40
  FONT_SET 2
  FONT_SIZE fw, fh
  fontHeight = fh
CATCH err$
  FONT_SET 0, 2
FINALLY

TEXT_COLOR RGB(255, 255, 255)
PRINT "GBX", 12, 200

STDOUT "TEXTHOEHE " + fontHeight + CHR$(10)
STDOUT "SCREEN " + SCREEN_WIDTH() + "x" + SCREEN_HEIGHT() + CHR$(10)

SCREEN_SAVE_BMP "out_render.bmp"
END
