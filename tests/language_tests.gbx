' ============================================================
' GameBasiX - Sprachtests
' Aufruf: gbx --tests tests/language_tests.gbx
' ============================================================

' ---------------------------------------------------------- Zahlen
ASSERT 2 + 3 = 5, "Addition"
ASSERT 2 * 3 = 6, "Multiplikation"
ASSERT 7 - 10 = -3, "Subtraktion"
ASSERT ABS(7 / 2 - 3.5) < 0.0001, "Division ergibt Kommazahl"
ASSERT 5 + 2 * 3 = 11, "Punkt vor Strich"
ASSERT (5 + 2) * 3 = 21, "Klammern"
ASSERT MOD(5, 3) = 2, "MOD"
ASSERT ABS(FMOD(11.5, 10) - 1.5) < 0.0001, "FMOD"
ASSERT POW(2, 10) = 1024, "POW"
ASSERT SQR(9) = 3, "SQR"
ASSERT INTEGER(-2.7) = -2, "INTEGER schneidet ab"
ASSERT FLOOR(-2.2) = -3, "FLOOR"
ASSERT CEIL(-2.2) = -2, "CEIL"
ASSERT SGN(-5) = -1, "SGN"
ASSERT ABS(SIN(30) - 0.5) < 0.0001, "SIN in Grad"
ASSERT ABS(ATAN(1, 1) - 45) < 0.0001, "ATAN in Grad"
ASSERT MIN(3, 7) = 3, "MIN"
ASSERT MAX(3, 7) = 7, "MAX"
ASSERT BAND(3, 6) = 2, "BAND"
ASSERT BOR(8, 12) = 12, "BOR"
ASSERT BXOR(3, 6) = 5, "BXOR"
ASSERT SHL(1, 4) = 16, "SHL"
ASSERT SHR(16, 4) = 1, "SHR"

' RND ist inklusiv 0..max
ok = TRUE
FOR i = 0 TO 200
  r = RND(10)
  IF r < 0 OR r > 10 THEN ok = FALSE
NEXT
ASSERT ok, "RND-Bereich 0..10"

' ---------------------------------------------------------- Strings
s$ = "GameBasiX"
ASSERT LEN(s$) = 9, "LEN"
ASSERT LEFT$(s$, 3) = "Gam", "LEFT$"
ASSERT RIGHT$(s$, 3) = "siX", "RIGHT$"
ASSERT MID$(s$, 3, 2) = "eB", "MID$ ist 0-basiert"
ASSERT MID$(s$, 2) = "meBasiX", "MID$ ohne Laenge"
ASSERT INSTR("Dream Design", "sign") = 8, "INSTR 0-basiert"
ASSERT INSTR("abc", "x") = -1, "INSTR nicht gefunden"
ASSERT INSTR_REVERSE("a.b.c", ".") = 3, "INSTR_REVERSE"
ASSERT UCASE$("abc") = "ABC", "UCASE$"
ASSERT LCASE$("ABC") = "abc", "LCASE$"
ASSERT TRIM$(("  hi  ")) = "hi", "TRIM$"
ASSERT REPLACE$("a-b-c", "-", "+") = "a+b+c", "REPLACE$"
ASSERT CHR$(65) = "A", "CHR$"
ASSERT ASC("A") = 65, "ASC"
ASSERT HEX$(255) = "FF", "HEX$"
ASSERT FORMAT$(6, 2, 3.14159) = "  3.14", "FORMAT$"
ASSERT FORMAT$("x={0} y={1}", 3, "ab") = "x=3 y=ab", "FORMAT$ mit Platzhaltern"
ASSERT FORMAT$("{0} von {0}", 7) = "7 von 7", "FORMAT$ Platzhalter doppelt"
ASSERT FORMAT$("{{rot}}") = "{rot}", "FORMAT$ geschweifte Klammern"
ASSERT FORMAT$("ohne Platzhalter") = "ohne Platzhalter", "FORMAT$ ohne Platzhalter"

DIM teile$[3]
teile$[0] = "a"
teile$[1] = "b"
teile$[2] = "c"
ASSERT JOIN$(teile$[], ", ") = "a, b, c", "JOIN$"
ASSERT JOIN$(teile$[], "") = "abc", "JOIN$ ohne Trenner"
ASSERT JOIN$(teile$[], "-", 1) = "b-c", "JOIN$ ab Index"
ASSERT JOIN$(teile$[], "-", 1, 1) = "b", "JOIN$ mit Anzahl"
ASSERT JOIN$(teile$[], "-", -2) = "b-c", "JOIN$ mit negativem Start"
DIM zahlen[2]
zahlen[0] = 1
zahlen[1] = 2.5
ASSERT JOIN$(zahlen[], "|") = "1|2.5", "JOIN$ mit Zahlen"
DIM leer$[0]
ASSERT JOIN$(leer$[], ",") = "", "JOIN$ auf leeres Array"
ASSERT SPLIT_STRING("a,b", teile$[], ",") = 2, "SPLIT_STRING bleibt"
ASSERT teile$[1] = "b", "SPLIT_STRING Ergebnis"
ASSERT "a" + 5 = "a5", "String + Zahl"
ASSERT 1.5 + "x" = "1.5x", "Zahl + String"

' ---------------------------------------------------------- Variablen
x$ = 5
ASSERT x$ = "5", "Typ-Suffix $ wandelt um"
n% = 2.7
ASSERT n% = 2, "Typ-Suffix % schneidet ab"
f# = 3
ASSERT ABS(f# - 3) < 0.0001, "Typ-Suffix #"
unbenutzt = 12
ASSERT unbenutzt * 2 = 24, "Implizite Variable"
CONSTANT MAXN = 10
ASSERT MAXN = 10, "CONSTANT"

' ---------------------------------------------------------- ENUM
' Ein Wert heisst immer ENUM.WERT. Der kurze Name allein ist ein Fehler -
' dafuer duerfen zwei ENUMs denselben Namen anbieten.
ENUM RICHTUNG
  NORD
  OST
  SUED = 10
  WEST
ENDENUM
ASSERT RICHTUNG.NORD = 0, "ENUM beginnt bei 0"
ASSERT RICHTUNG.OST = 1, "ENUM zaehlt weiter"
ASSERT RICHTUNG.SUED = 10, "ENUM mit eigenem Wert"
ASSERT RICHTUNG.WEST = 11, "ENUM zaehlt nach eigenem Wert weiter"

ENUM MASKE
  KEINE
  ROT = 0x01
  GRUEN = 0x02
  ALLE = MASKE.ROT + MASKE.GRUEN
ENDENUM
ASSERT MASKE.KEINE = 0, "ENUM-Wert 0"
ASSERT MASKE.ROT = 1 AND MASKE.GRUEN = 2, "ENUM mit Hex-Werten"
ASSERT MASKE.ALLE = 3, "ENUM-Wert aus einem Ausdruck"

' Zwei ENUMs mit gleichen Wertnamen: der Punkt macht sie unterscheidbar.
ENUM AMPEL
  ROT
  GRUEN
ENDENUM
ASSERT AMPEL.ROT = 0 AND AMPEL.GRUEN = 1, "gleiche Namen in zwei ENUMs"
ASSERT MASKE.ROT = 1 AND AMPEL.ROT = 0, "gleicher Name, eigener Wert"

' ENUM in einer Funktion: die Werte sind wie CONSTANT globale Konstanten
FUNCTION enumName:
  IF RICHTUNG.NORD = 0 THEN RETURN "NORD"
  RETURN "?"
ENDFUNCTION
ASSERT enumName() = "NORD", "ENUM in einer FUNCTION"

' Der Wert darf im Quelltext vor seiner ENUM-Deklaration stehen
' (wichtig fuer INCLUDE-Reihenfolgen).
FUNCTION spaetWert:
  RETURN SPAET.ANTWORT
ENDFUNCTION
ENUM SPAET
  ANTWORT = 42
ENDENUM
ASSERT spaetWert() = 42, "ENUM-Wert vor der Deklaration"

' ---------------------------------------------------------- Kurzformen
k = 5
k += 2
ASSERT k = 7, "+="
k -= 3
ASSERT k = 4, "-="
k *= 5
ASSERT k = 20, "*="
k /= 4
ASSERT k = 5, "/="
t$ = "a"
t$ += "b"
ASSERT t$ = "ab", "+= auf einem String"
t$ += 3
ASSERT t$ = "ab3", "+= auf String mit Zahl"
DIM kurz[3]
kurz[1] = 2
kurz[1] += 10
ASSERT kurz[1] = 12, "+= auf einem Array-Element"

TYPE KURZPUNKT
  x AS FLOAT
ENDTYPE
LOCAL kurzpunkt AS KURZPUNKT
kurzpunkt.x = 2
kurzpunkt.x += 3
ASSERT kurzpunkt.x = 5, "+= auf einem TYPE-Feld"


' ---------------------------------------------------------- Kontrollfluss
v = 0
IF 1 THEN v = 1 ELSE v = 2
ASSERT v = 1, "Einzeiler IF/THEN"
IF 0 THEN v = 3 ELSE v = 4
ASSERT v = 4, "Einzeiler IF/ELSE"

v = 0
IF 0
  v = 1
ELSEIF 0
  v = 2
ELSEIF 1
  v = 3
ELSE
  v = 4
ENDIF
ASSERT v = 3, "ELSEIF"

sum = 0
FOR i = 1 TO 5
  sum = sum + i
NEXT
ASSERT sum = 15, "FOR"

sum = 0
FOR i = 10 TO 1 STEP -2
  sum = sum + i
NEXT
ASSERT sum = 30, "FOR mit negativem STEP"

cnt = 0
j = 0
WHILE j < 10
  INC j
  IF MOD(j, 2) = 0 THEN CONTINUE
  INC cnt
  IF j = 7 THEN BREAK
WEND
ASSERT cnt = 4, "WHILE mit CONTINUE/BREAK"

r = 0
REPEAT
  INC r
UNTIL r = 5
ASSERT r = 5, "REPEAT/UNTIL"

sel = 0
SELECT 4
CASE 1, 2
  sel = 10
CASE 3 TO 5
  sel = 20
CASE > 5
  sel = 30
DEFAULT
  sel = 40
ENDSELECT
ASSERT sel = 20, "SELECT mit Bereich"

sel = 0
SELECT 99
CASE 1
  sel = 1
DEFAULT
  sel = 42
ENDSELECT
ASSERT sel = 42, "SELECT DEFAULT"

' ---------------------------------------------------------- Felder
DIM a[5]
FOR i = 0 TO 4
  a[i] = i * 2
NEXT
ASSERT a[0] = 0, "Array 0-basiert"
ASSERT a[4] = 8, "Array letztes Element"
ASSERT a[-1] = 8, "Negativer Index"
ASSERT ARRAY_BOUNDS(a[], 0) = 5, "ARRAY_BOUNDS"
ASSERT LEN(a[]) = 5, "LEN(Array)"

DIM m[2][3]
m[1][2] = 7
ASSERT m[1][2] = 7, "Mehrdimensionales Array"
ASSERT ARRAY_BOUNDS(m[], 1) = 3, "ARRAY_BOUNDS Dimension 1"

REDIM a[8]
ASSERT ARRAY_BOUNDS(a[], 0) = 8, "REDIM vergroessert"
ASSERT a[2] = 4, "REDIM erhaelt Daten"

DIMPUSH a[], 99
ASSERT ARRAY_BOUNDS(a[], 0) = 9, "DIMPUSH"
ASSERT a[8] = 99, "DIMPUSH Wert"
DIMDEL a[], 8
ASSERT ARRAY_BOUNDS(a[], 0) = 8, "DIMDEL"

DIMDATA zahlen[], 3, 4, 5
ASSERT ARRAY_BOUNDS(zahlen[], 0) = 3, "DIMDATA Laenge"
ASSERT zahlen[2] = 5, "DIMDATA Wert"

sum = 0
FOREACH zahl IN zahlen[]
  sum = sum + zahl
NEXT
ASSERT sum = 12, "FOREACH"

FOREACH zahl IN zahlen[]
  zahl = zahl * 10
NEXT
ASSERT zahlen[1] = 40, "FOREACH ist BYREF"

' ---------------------------------------------------------- Strings-Array
DIM namen$[2]
namen$[0] = "Ada"
namen$[1] = "Grace"
ASSERT LEN(namen$[]) = 2, "String-Array"
ASSERT namen$[1] = "Grace", "String-Array Inhalt"

DIM teile$[0]
cnt = SPLIT_STRING("a,b,c", teile$[], ",")
ASSERT cnt = 3, "SPLIT_STRING Anzahl"
ASSERT teile$[1] = "b", "SPLIT_STRING Inhalt"

' ---------------------------------------------------------- TYPE
TYPE POINT
  x AS FLOAT
  y AS FLOAT
ENDTYPE

TYPE RECT
  a AS POINT
  b AS POINT
  name$
ENDTYPE

LOCAL p AS POINT
p.x = 3
p.y = 1.5
ASSERT p.x = 3, "TYPE Feld x"
ASSERT ABS(p.y - 1.5) < 0.0001, "TYPE Feld y"

LOCAL rr AS RECT
rr.a.x = 1
rr.b.y = 9
rr.name$ = "Kasten"
ASSERT rr.b.y = 9, "Verschachtelter TYPE"
ASSERT rr.name$ = "Kasten", "TYPE Stringfeld"

DIM punkte[3] AS POINT
punkte[1].x = 42
ASSERT punkte[1].x = 42, "Array von TYPEs"
ASSERT punkte[0].x = 0, "TYPE-Feld Standardwert"

DIMPUSH punkte[], punkte[1]
ASSERT ARRAY_BOUNDS(punkte[], 0) = 4, "DIMPUSH auf TYPE-Array"

' Offenes GLOBAL-Array eines TYPE: startet leer, waechst mit DIMPUSH.
TYPE MYTYPE
  x%
  y%
  METHOD setXY: x%, y%
    self.x = x
    self.y = y
  ENDMETHOD
ENDTYPE

GLOBAL myTypes[] AS MYTYPE
ASSERT LEN(myTypes) = 0, "GLOBAL a[] AS TYPE ist leer"
DIMPUSH myTypes[], 0
DIMPUSH myTypes[], 0
ASSERT LEN(myTypes) = 2, "DIMPUSH auf GLOBAL a[] AS TYPE"
myTypes[1].setXY(3, 4)
ASSERT myTypes[1].x = 3, "METHOD auf offenem TYPE-Array"
ASSERT myTypes[1].y = 4, "METHOD setzt zweites Feld"
ASSERT myTypes[0].x = 0, "neues Element hat Standardwerte"

' Standardwerte direkt in der TYPE-Definition (x% = 0)
TYPE ZAEHLER
  stand% = 7
  schritt% = 30
  name$ = "neu"
  f AS FLOAT = 2.5
ENDTYPE

LOCAL z AS ZAEHLER
ASSERT z.stand% = 7, "TYPE-Standardwert Integer"
ASSERT z.schritt% = 30, "TYPE-Standardwert zweites Feld"
ASSERT z.name$ = "neu", "TYPE-Standardwert String"
ASSERT ABS(z.f - 2.5) < 0.0001, "TYPE-Standardwert Float"

DIM zaehler[2] AS ZAEHLER
ASSERT zaehler[0].stand% = 7, "Standardwert im TYPE-Array"
ASSERT zaehler[1].schritt% = 30, "Standardwert im TYPE-Array (2)"

' Jede Instanz bekommt einen eigenen Wert
zaehler[0].stand% = 99
ASSERT zaehler[0].stand% = 99, "Instanz ändern"
ASSERT zaehler[1].stand% = 7, "andere Instanz bleibt beim Standardwert"

' Verschachtelter TYPE: Standardwerte greifen auch innen
TYPE RAHMEN
  pos AS POINT
  beschriftung$ = "M"
ENDTYPE

LOCAL rahmen AS RAHMEN
rahmen.pos.x = 4
ASSERT rahmen.pos.x = 4, "Feld im verschachtelten TYPE"
ASSERT rahmen.beschriftung$ = "M", "Standardwert neben verschachteltem TYPE"

' Standardwert als Ausdruck wird pro Instanz ausgewertet
TYPE SUMME
  a% = 2
  b% = 3
  total% = 2 + 3
ENDTYPE

LOCAL summe AS SUMME
ASSERT summe.total% = 5, "Standardwert als Ausdruck"

' Standardwert darf eine Konstante sein
CONSTANT BASISWERT% = 12
TYPE KONSTANTE
  wert% = BASISWERT%
ENDTYPE

LOCAL konst AS KONSTANTE
ASSERT konst.wert% = 12, "Standardwert aus Konstante"

' ---------------------------------------------------------- Funktionen
FUNCTION add: a, b
  RETURN a + b
ENDFUNCTION

FUNCTION greet: name$, punct$ = "!"
  RETURN name$ + punct$
ENDFUNCTION

FUNCTION bump: BYREF wert, amount = 1
  INC wert, amount
ENDFUNCTION

FUNCTION fib: n
  IF n < 2 THEN RETURN n
  RETURN fib(n - 1) + fib(n - 2)
ENDFUNCTION

FUNCTION early: v
  IF v > 0 THEN EXIT
  RETURN 99
ENDFUNCTION

FUNCTION counter:
  STATIC n
  INC n
  RETURN n
ENDFUNCTION

FUNCTION shadow: dummy
  LOCAL globalVar
  globalVar = 99
  RETURN globalVar
ENDFUNCTION

FUNCTION setGlobal:
  GLOBAL globalVar = 42
ENDFUNCTION

ASSERT add(2, 3) = 5, "FUNCTION"
ASSERT greet("Hi") = "Hi!", "Standardparameter"
ASSERT greet("Hi", "?") = "Hi?", "Parameter ueberschrieben"
ASSERT fib(10) = 55, "Rekursion"
ASSERT early(1) = 0, "EXIT"
ASSERT early(-1) = 99, "EXIT nur bei Abbruch"

wert = 1
bump(wert)
ASSERT wert = 2, "BYREF"
bump(wert, 5)
ASSERT wert = 7, "BYREF mit Betrag"

DIM feld[2]
feld[0] = 10
bump(feld[0], 3)
ASSERT feld[0] = 13, "BYREF auf Array-Element"

lok = 1
ASSERT counter() = 1, "STATIC 1"
ASSERT counter() = 2, "STATIC 2"
ASSERT shadow(0) = 99, "LOCAL in Funktion"
ASSERT lok = 1, "LOCAL verdeckt nichts"

globalVar = 1
setGlobal()
ASSERT globalVar = 42, "GLOBAL in Funktion"

' GLOBAL/LOCAL/STATIC mit Klammern legen ein Array an - wie DIM, nur in
' genau diesem Bereich.
GLOBAL raster[2] AS ZAEHLER
ASSERT raster[0].stand% = 7, "GLOBAL TYPE-Array: Standardwert je Platz"
raster[1].stand% = 3
ASSERT raster[1].stand% = 3, "GLOBAL TYPE-Array beschreibbar"
ASSERT raster[0].stand% = 7, "GLOBAL TYPE-Array: Plaetze getrennt"
ASSERT ARRAY_BOUNDS(raster[], 0) = 2, "GLOBAL TYPE-Array: Groesse"

GLOBAL zahlen[3]
zahlen[2] = 5
ASSERT zahlen[2] = 5, "GLOBAL Array ohne TYPE"
ASSERT zahlen[0] = 0, "GLOBAL Array: freie Plaetze auf 0"

GLOBAL woerter$[2]
woerter[1] = "ab"
ASSERT woerter[1] = "ab", "GLOBAL String-Array"

FUNCTION lokalArray:
  LOCAL werte[4]
  werte[1] = 2
  werte[3] = 5
  RETURN werte[1] + werte[3]
ENDFUNCTION
ASSERT lokalArray() = 7, "LOCAL Array in Funktion"

FUNCTION lokalArrayTyp:
  LOCAL teile[2] AS ZAEHLER
  teile[1].stand% = 9
  RETURN teile[1].stand% + ARRAY_BOUNDS(teile[], 0)
ENDFUNCTION
ASSERT lokalArrayTyp() = 11, "LOCAL TYPE-Array in Funktion"

' Ein LOCAL-Array verdeckt ein GLOBAL-Array gleichen Namens
FUNCTION rasterLokal:
  LOCAL raster[2] AS ZAEHLER
  raster[0].stand% = 1
  RETURN raster[0].stand%
ENDFUNCTION
ASSERT rasterLokal() = 1, "LOCAL Array verdeckt GLOBAL"
ASSERT raster[0].stand% = 7, "GLOBAL bleibt dabei unberuehrt"

' Ein GLOBAL-Array aus einer Funktion gilt danach ueberall
FUNCTION baueGlobal:
  GLOBAL gitter[2]
  gitter[0] = 9
ENDFUNCTION
baueGlobal()
ASSERT gitter[0] = 9, "GLOBAL Array aus Funktion"

FUNCTION statischArray:
  STATIC zaehl[1]
  zaehl[0] = zaehl[0] + 1
  RETURN zaehl[0]
ENDFUNCTION
ASSERT statischArray() = 1, "STATIC Array 1"
ASSERT statischArray() = 2, "STATIC Array behaelt den Wert"

' SUB + GOSUB
GOSUB subSet

' ---------------------------------------------------------- Sonstiges
aa = 1
bb = 2
SWAP aa, bb
ASSERT aa = 2 AND bb = 1, "SWAP"

cc = 10
INC cc, 5
ASSERT cc = 15, "INC"
DEC cc, 6
ASSERT cc = 9, "DEC"

' GOTO mit Marke
gi = 0
marke:
INC gi
IF gi < 3 THEN GOTO marke
ASSERT gi = 3, "GOTO"

' IIF wertet nur den gewaehlten Zweig aus
sideHits = 0
iifval = IIF(1, 10, sideEffect(sideHits))
ASSERT iifval = 10, "IIF"
ASSERT sideHits = 0, "IIF wertet nur einen Zweig aus"

' TRY / THROW
caught$ = ""
TRY
  THROW "Boom"
CATCH e$
  caught$ = e$
FINALLY
ASSERT caught$ = "Boom", "TRY/THROW/CATCH"

' Laufzeitfehler werden von TRY gefangen
outOfBounds = FALSE
TRY
  bad = feld[99]
CATCH err$
  outOfBounds = TRUE
FINALLY
ASSERT outOfBounds, "TRY faengt Array-Fehler"

' RECT_COLLIDE
ASSERT RECT_COLLIDE(0, 0, 10, 10, 5, 5, 10, 10) = 1, "RECT_COLLIDE Treffer"
ASSERT RECT_COLLIDE(0, 0, 10, 10, 20, 20, 5, 5) = 0, "RECT_COLLIDE kein Treffer"

' Zeit
ASSERT ELAPSED_TIME() >= 0, "ELAPSED_TIME"
ASSERT DELTA_TIME() >= 0, "DELTA_TIME"

' ---------------------------------------------------------- TYPE-Methoden
TYPE METHODKISTE
  w AS FLOAT
  h AS FLOAT

  METHOD flaeche:
    RETURN w * h
  ENDMETHOD

  METHOD skalieren: faktor
    w = w * faktor
    h = h * faktor
  ENDMETHOD

  METHOD doppelt:
    skalieren(2)
    RETURN flaeche()
  ENDMETHOD

  METHOD mitLokal: w
    RETURN w + 1
  ENDMETHOD

  ' Felder als Argument eingebauter Befehle (frueher kam dort 0 an).
  METHOD abstand%:
    RETURN ABS(w - h)
  ENDMETHOD

  METHOD beschreibung$:
    RETURN "w=" + FORMAT$(4, 0, w) + " h=" + FORMAT$(4, 0, h)
  ENDMETHOD
ENDTYPE

TYPE METHODREGAL
  fach AS METHODKISTE
ENDTYPE

LOCAL box AS METHODKISTE
box.w = 4
box.h = 2
ASSERT box.flaeche() = 8, "METHOD mit RETURN"
box.skalieren(3)
ASSERT box.w = 12, "METHOD schreibt erstes Feld"
ASSERT box.h = 6, "METHOD schreibt zweites Feld"
ASSERT box.doppelt() = 288, "METHOD ruft eigene METHOD auf"
ASSERT box.mitLokal(5) = 6, "Parameter verdeckt das Feld"
ASSERT box.w = 24, "doppelt hat weiterskaliert"
ASSERT box.abstand%() = 12, "Feld als Argument eines Befehls"
ASSERT box.beschreibung$() = "w=  24 h=  12", "Feld in einer String-METHOD"

DIM kisten[2] AS METHODKISTE
kisten[1].w = 3
kisten[1].h = 3
ASSERT kisten[1].flaeche() = 9, "METHOD auf Array-Element"
kisten[1].skalieren(2)
ASSERT kisten[1].h = 6, "Array-Element bleibt veraendert"

LOCAL regal AS METHODREGAL
regal.fach.w = 2
regal.fach.h = 5
ASSERT regal.fach.flaeche() = 10, "METHOD auf verschachteltem TYPE"
regal.fach.skalieren(2)
ASSERT regal.fach.w = 4, "verschachteltes Feld schreibt zurueck"

' SELF als eigenes Objekt
TYPE METHODPUNKT
  x AS FLOAT
  y AS FLOAT

  METHOD summe:
    RETURN self.x + self.y
  ENDMETHOD

  METHOD verschieben: dx, dy
    self.x = self.x + dx
    self.y = self.y + dy
  ENDMETHOD
ENDTYPE

LOCAL mp AS METHODPUNKT
mp.x = 2
mp.y = 3
ASSERT mp.summe() = 5, "SELF liest Felder"
mp.verschieben(1, 4)
ASSERT mp.x = 3 AND mp.y = 7, "SELF schreibt Felder"

' ---------------------------------------------- Arrays als TYPE-Felder
' items[3] AS TYPE, zahlen[2] und offen[] (leer, waechst mit DIMPUSH).
TYPE FA_PUNKT
  x AS FLOAT
  y AS FLOAT
  name$ = "p"
ENDTYPE

TYPE FA_BEHALTER
  punkte[3] AS FA_PUNKT
  zahlen[2]
  namen[2] AS STRING
  offen[] AS FA_PUNKT

  METHOD anhaengen: x AS FLOAT
    DIMPUSH offen[], 0
    offen[LEN(offen) - 1].x = x
  ENDMETHOD

  METHOD summe:
    faSumme = 0
    FOREACH faPunkt IN offen[]
      faSumme = faSumme + faPunkt.x
    NEXT
    RETURN faSumme
  ENDMETHOD
ENDTYPE

LOCAL korb AS FA_BEHALTER
ASSERT LEN(korb.punkte) = 3, "Feld-Array hat die Groesse aus dem TYPE"
ASSERT korb.punkte[0].x = 0, "Element startet mit dem Feld-Standardwert"
ASSERT korb.punkte[0].name$ = "p", "Textfeld im Element"
ASSERT LEN(korb.namen) = 2, "Feld-Array aus Strings"
korb.punkte[1].x = 7
korb.punkte[1].name$ = "zwei"
ASSERT korb.punkte[1].x = 7 AND korb.punkte[1].name$ = "zwei", "Element schreiben"
ASSERT korb.punkte[0].x = 0, "Nachbar bleibt unveraendert"
korb.zahlen[0] = 5
ASSERT korb.zahlen[0] = 5, "Feld-Array aus Zahlen"
ASSERT LEN(korb.offen) = 0, "states[] startet leer"
korb.anhaengen(2)
korb.anhaengen(3)
ASSERT LEN(korb.offen) = 2, "DIMPUSH im Feld-Array"
ASSERT korb.summe() = 5, "FOREACH ueber das Feld-Array"
DIM korb.punkte[4]
ASSERT LEN(korb.punkte) = 4, "DIM auf ein Feld-Array"
ASSERT korb.punkte[1].x = 0, "DIM legt die Elemente neu an"
REDIM korb.zahlen[3]
ASSERT LEN(korb.zahlen) = 3 AND korb.zahlen[0] = 5, "REDIM behaelt die Werte"

' Jedes Objekt hat sein eigenes Feld-Array
LOCAL zweiter AS FA_BEHALTER
zweiter.punkte[0].x = 9
ASSERT korb.punkte[0].x = 0, "Feld-Arrays sind pro Objekt getrennt"

' TYPE-Array, in dessen Elementen wieder Feld-Arrays stecken
DIM reihe[2] AS FA_BEHALTER
reihe[1].punkte[2].y = 4
ASSERT reihe[1].punkte[2].y = 4, "Feld-Array in einem TYPE-Array"
ASSERT reihe[0].punkte[2].y = 0, "Elemente bleiben getrennt"

' Ein Skalar darf das Array nicht ersetzen
faErsetzt = FALSE
TRY
  korb.punkte = 1
CATCH faErr$
  faErsetzt = TRUE
FINALLY
ASSERT faErsetzt, "Skalar auf ein Feld-Array meldet einen Fehler"
ASSERT korb.punkte[0].name$ = "p", "Feld-Array bleibt nach dem Fehler heil"

' -------------------------------- Arrays mit mehreren Dimensionen
' Mehrere Werte in einer Klammer sind mehrere Dimensionen: map[x, y] ist die
' Kurzform von map[x][y], DIM feld[w, h] von DIM feld[w][h]. Wie viele
' Dimensionen ein Array hat, entscheidet die Schreibweise im Programm.
DIM ndMap[3, 4]
FOR ndY = 0 TO 3
  FOR ndX = 0 TO 2
    ndMap[ndX, ndY] = ndX * 10 + ndY
  NEXT
NEXT
ASSERT ndMap[2, 3] = 23, "DIM a[w, h] und Zugriff mit [x, y]"
ASSERT ndMap[2][3] = 23, "[x][y] und [x, y] sind dasselbe"
ASSERT LEN(ndMap) = 3, "LEN zaehlt die Reihen"
ASSERT LEN(ndMap[0]) = 4, "LEN auf eine Reihe zaehlt die Spalten"
ndMap[1, 1] += 5
ASSERT ndMap[1, 1] = 16, "+= auf eine Zelle"
ndBump(ndMap[0, 0])
ASSERT ndMap[0, 0] = 1, "BYREF bekommt die Zelle"

' Drei Dimensionen
DIM ndWuerfel[2, 3, 4]
ndWuerfel[1, 2, 3] = 42
ASSERT ndWuerfel[1, 2, 3] = 42, "drei Dimensionen"
ASSERT LEN(ndWuerfel[1]) = 3, "LEN auf die zweite Dimension"
ASSERT LEN(ndWuerfel[1, 2]) = 4, "LEN auf die dritte Dimension"

' GLOBAL mit zwei Groessen
GLOBAL ndGlobal[2, 2]
ndGlobal[1, 1] = 7
ASSERT ndGlobal[1, 1] = 7, "GLOBAL a[w, h]"

' REDIM behaelt, was noch passt
REDIM ndMap[4, 5]
ASSERT LEN(ndMap) = 4 AND LEN(ndMap[0]) = 5, "REDIM aendert beide Groessen"
ASSERT ndMap[2, 3] = 23, "REDIM behaelt die Zellen"

' Eine leere Dimension bleibt leer
DIM ndLeer[2, 0]
ASSERT LEN(ndLeer) = 2 AND LEN(ndLeer[0]) = 0, "leere Dimension"

' FOREACH laeuft ueber die Reihen
ndSumme = 0
FOREACH ndReihe IN ndMap[]
  ndSumme = ndSumme + LEN(ndReihe)
NEXT
ASSERT ndSumme = 20, "FOREACH ueber die Reihen"

' Text und TYPE in zwei Dimensionen
DIM ndText[2, 2] AS STRING
ndText[1, 1] = "z"
ASSERT ndText[1, 1] = "z", "Text-Array mit zwei Dimensionen"

TYPE ND_PUNKT
  wert
ENDTYPE

DIM ndBild[2, 2] AS ND_PUNKT
ndBild[1, 1].wert = 6
ASSERT ndBild[1, 1].wert = 6, "TYPE-Array mit zwei Dimensionen"
ASSERT ndBild[0, 0].wert = 0, "Nachbarzelle bleibt bei 0"

' Feld-Array mit zwei Dimensionen
TYPE ND_FELD
  kacheln[2, 3] AS ND_PUNKT
  zahlen[2, 2]
ENDTYPE

LOCAL ndFeld AS ND_FELD
ndFeld.kacheln[1, 2].wert = 9
ASSERT ndFeld.kacheln[1, 2].wert = 9, "Feld-Array mit zwei Dimensionen"
ASSERT LEN(ndFeld.kacheln) = 2 AND LEN(ndFeld.kacheln[0]) = 3, "Feld-Array kennt beide Groessen"
DIM ndFeld.zahlen[3, 3]
ASSERT LEN(ndFeld.zahlen) = 3 AND LEN(ndFeld.zahlen[0]) = 3, "DIM auf ein Feld mit zwei Dimensionen"
ndFeld.zahlen[1, 1] = 4
ndFeld.zahlen[2, 2] = 5
REDIM ndFeld.zahlen[2, 2]
ASSERT ndFeld.zahlen[1, 1] = 4, "REDIM im Feld behaelt die Zellen"

' Eine Reihe ist selbst ein Array und laesst sich nicht mit einem Wert ersetzen
ndReiheFehler = FALSE
TRY
  ndMap[0] = 1
CATCH ndReiheErr$
  ndReiheFehler = TRUE
FINALLY
ASSERT ndReiheFehler, "ein Wert ersetzt keine Reihe"

' Zu viele Zellen werden abgelehnt
ndZuGross = FALSE
TRY
  DIM ndRiesig[100000, 2000]
CATCH ndGrossErr$
  ndZuGross = TRUE
FINALLY
ASSERT ndZuGross, "zu grosses Array meldet einen Fehler"

' ------------------------------------------- Arrays sortieren und finden
DIM neuZahlen[5]
neuZahlen[0] = 4 : neuZahlen[1] = 1 : neuZahlen[2] = 3 : neuZahlen[3] = 1 : neuZahlen[4] = 2
ASSERT ARRAY_SORT(neuZahlen) = 5, "ARRAY_SORT liefert die Laenge"
ASSERT neuZahlen[0] = 1 AND neuZahlen[1] = 1 AND neuZahlen[2] = 2 AND neuZahlen[3] = 3 AND neuZahlen[4] = 4, "ARRAY_SORT aufsteigend"
ARRAY_SORT(neuZahlen, -1)
ASSERT neuZahlen[0] = 4 AND neuZahlen[4] = 1, "ARRAY_SORT absteigend"
ARRAY_SORT(neuZahlen)
ASSERT ARRAY_FIND(neuZahlen, 3) = 3, "ARRAY_FIND findet den Wert"
ASSERT ARRAY_FIND(neuZahlen, 99) = -1, "ARRAY_FIND ohne Treffer"
ASSERT ARRAY_FIND(neuZahlen, 1, 2) = -1, "ARRAY_FIND ab Startindex"

DIM neuTexte$[3]
neuTexte$[0] = "Oda" : neuTexte$[1] = "Ada" : neuTexte$[2] = "Bea"
ARRAY_SORT(neuTexte$)
ASSERT neuTexte$[0] = "Ada" AND neuTexte$[2] = "Oda", "ARRAY_SORT mit Texten"

TYPE NEU_KARTE
  rang AS INTEGER
  name$
ENDTYPE
DIM neuKarten[3] AS NEU_KARTE
neuKarten[0].rang = 7 : neuKarten[0].name$ = "Sieben"
neuKarten[1].rang = 2 : neuKarten[1].name$ = "Zwei"
neuKarten[2].rang = 9 : neuKarten[2].name$ = "Neun"
ARRAY_SORT(neuKarten, 1, "rang")
ASSERT neuKarten[0].rang = 2 AND neuKarten[2].rang = 9, "ARRAY_SORT nach TYPE-Feld"
ASSERT neuKarten[1].name$ = "Sieben", "ARRAY_SORT nimmt den Datensatz mit"

' ---------------------------------------------------------- Dictionary
bestand = DICT_NEW()
DICT_SET(bestand, "aepfel", 3)
DICT_SET(bestand, "birnen", 5)
ASSERT LEN(bestand) = 2, "LEN eines Dictionary"
ASSERT DICT_GET(bestand, "aepfel") = 3, "DICT_GET"
ASSERT DICT_GET(bestand, "kirschen", -1) = -1, "DICT_GET mit Vorgabe"
ASSERT DICT_HAS(bestand, "birnen"), "DICT_HAS"
ASSERT DICT_HAS(bestand, "kirschen") = 0, "DICT_HAS ohne Schluessel"
DICT_SET(bestand, "aepfel", 4)
ASSERT DICT_COUNT(bestand) = 2, "DICT_SET ueberschreibt"
ASSERT DICT_GET(bestand, "aepfel") = 4, "DICT_SET neuer Wert"
ASSERT DICT_KEY$(bestand, 0) = "aepfel" AND DICT_VALUE(bestand, 1) = 5, "DICT_KEY$/DICT_VALUE"
alleSchluessel$ = DICT_KEYS(bestand)
ASSERT LEN(alleSchluessel$) = 2 AND alleSchluessel$[0] = "aepfel", "DICT_KEYS behaelt die Reihenfolge"
alleWerte = DICT_VALUES(bestand)
ASSERT alleWerte[1] = 5, "DICT_VALUES"
ASSERT DICT_DELETE(bestand, "birnen") = 1, "DICT_DELETE"
ASSERT DICT_DELETE(bestand, "birnen") = 0, "DICT_DELETE ohne Schluessel"
ASSERT LEN(bestand) = 1, "LEN nach DICT_DELETE"
DICT_CLEAR(bestand)
ASSERT LEN(bestand) = 0, "DICT_CLEAR"
ASSERT ISA(bestand, "dict"), "ISA erkennt ein Dictionary"

' ------------------------------------------ TRY mit mehreren CATCH und FINALLY
neuVersuche = 0
neuErgebnis$ = ""
TRY
  neuVersuche += 1
  THROW "kaputt"
CATCH f$ WHEN INSTR(f$, "anders") >= 0
  neuErgebnis$ = "falsch"
CATCH f$ WHEN INSTR(f$, "kaputt") >= 0
  neuErgebnis$ = "richtig"
CATCH f$
  neuErgebnis$ = "rest"
FINALLY
  neuVersuche += 10
ENDTRY
ASSERT neuErgebnis$ = "richtig", "CATCH mit WHEN waehlt den Zweig"
ASSERT neuVersuche = 11, "FINALLY laeuft nach dem CATCH"

neuZwei = 0
TRY
  neuZwei = 1
FINALLY
  neuZwei = neuZwei + 1
ENDTRY
ASSERT neuZwei = 2, "FINALLY ohne Fehler"

neuStufen = 0
TRY
  TRY
    THROW "tief"
  FINALLY
    neuStufen += 1
  ENDTRY
CATCH a$
  neuStufen += 10
ENDTRY
ASSERT neuStufen = 11, "FINALLY laeuft auch beim Weitergereichen"

' ------------------------------------------------------- Funktionswerte
FUNCTION neuVerdoppeln: x
  RETURN x * 2
ENDFUNCTION
FUNCTION neuAnwenden: f, wert
  RETURN f(wert)
ENDFUNCTION
ASSERT neuAnwenden(@neuVerdoppeln, 21) = 42, "Funktion als Wert (Rueckruf)"
ASSERT ISA(@neuVerdoppeln, "function"), "ISA erkennt eine Funktion"

' ------------------------------------------------ Vererbung und Interfaces
INTERFACE NEU_ZEICHENBAR
  SUB zeichnen: x, y
ENDINTERFACE

TYPE NEU_FIGUR
  x AS INTEGER
  y AS INTEGER
  farbe = 7

  METHOD info:
    RETURN "Figur"
  ENDMETHOD

  METHOD zeichnen: px, py
    x = px
    y = py
  ENDMETHOD
ENDTYPE

TYPE NEU_KREIS EXTENDS NEU_FIGUR IMPLEMENTS NEU_ZEICHENBAR
  radius AS INTEGER

  METHOD info:
    RETURN "Kreis"
  ENDMETHOD
ENDTYPE

LOCAL neuKreis AS NEU_KREIS
neuKreis.radius = 5
neuKreis.zeichnen(10, 20)
ASSERT neuKreis.x = 10 AND neuKreis.y = 20, "geerbte Felder und Methode"
ASSERT neuKreis.farbe = 7, "geerbter Standardwert"
ASSERT neuKreis.info() = "Kreis", "eigene Methode verdeckt die geerbte"
ASSERT ISA(neuKreis, "NEU_KREIS") AND ISA(neuKreis, "NEU_FIGUR"), "ISA kennt die Basis"
ASSERT ISA(neuKreis, "NEU_ZEICHENBAR"), "ISA kennt das INTERFACE"
ASSERT ISA(neuKreis, "NEU_ETWAS_ANDERES") = 0, "ISA ohne Treffer"

' Konsole
STDOUT "Sprachtests durchgelaufen." + CHR$(10)

END

' ---------------------------------------------------------- SUBs
SUB subSet:
  subWert = 123
ENDSUB

FUNCTION sideEffect: BYREF c
  INC c
  RETURN 1
ENDFUNCTION

FUNCTION ndBump: BYREF zelle
  zelle += 1
  RETURN zelle
ENDFUNCTION
