' ============================================================
' GameBasiX - Tests fuer Dateizugriff
'
'   gbx --headless --tests tests/file_tests.gbx
'
' Legt Testdateien neben diesem Skript an und raeumt sie am
' Ende wieder weg.
' ============================================================

bin$ = "fileio_test.bin"
lin$ = "fileio_lines.txt"
app$ = "fileio_append.txt"
cpy$ = "fileio_copy.bin"
mov$ = "fileio_moved.bin"
IF FILE_EXISTS(bin$) THEN FILE_DELETE bin$
IF FILE_EXISTS(lin$) THEN FILE_DELETE lin$
IF FILE_EXISTS(app$) THEN FILE_DELETE app$
IF FILE_EXISTS(cpy$) THEN FILE_DELETE cpy$
IF FILE_EXISTS(mov$) THEN FILE_DELETE mov$

' ------------------------------------------------------ schreiben
ASSERT FILE_OPEN(1, bin$, 0) = 1, "FILE_OPEN schreiben"
FILE_WRITE_BYTE 1, 200
FILE_WRITE_BYTE 1, -1
FILE_WRITE_WORD 1, 513
FILE_WRITE_UWORD 1, 65535
FILE_WRITE_LONG 1, 123456
FILE_WRITE_ULONG 1, 4000000000
FILE_WRITE_DOUBLE 1, 1.5
FILE_WRITE_FLOAT 1, -2.25
FILE_WRITE_STR 1, "abc"
FILE_CLOSE 1

ASSERT FILE_SIZE(bin$) = 29, "FILE_SIZE nach dem Schreiben"
ASSERT FILE_EXISTS(bin$) = 1, "FILE_EXISTS"
ASSERT FILE_EXISTS("gibt_es_nicht.bin") = 0, "FILE_EXISTS fehlende Datei"
ASSERT FILE_SIZE("gibt_es_nicht.bin") = -1, "FILE_SIZE fehlende Datei"

' ---------------------------------------------------------- lesen
ASSERT FILE_OPEN(1, bin$, 1) = 1, "FILE_OPEN lesen"
FILE_READ_BYTE 1, b
FILE_READ_UBYTE 1, ub
FILE_READ_WORD 1, w
FILE_READ_UWORD 1, uw
FILE_READ_LONG 1, l
FILE_READ_ULONG 1, ul
FILE_READ_DOUBLE 1, d#
FILE_READ_FLOAT 1, s#
FILE_READ_STR 1, text$, 3

ASSERT b = -56, "FILE_READ_BYTE vorzeichenbehaftet"
ASSERT ub = 255, "FILE_READ_UBYTE"
ASSERT w = 513, "FILE_READ_WORD"
ASSERT uw = 65535, "FILE_READ_UWORD"
ASSERT l = 123456, "FILE_READ_LONG"
ASSERT ul = 4000000000, "FILE_READ_ULONG"
ASSERT d# = 1.5, "FILE_READ_DOUBLE"
ASSERT s# = -2.25, "FILE_READ_FLOAT"
ASSERT text$ = "abc", "FILE_READ_STR"
ASSERT FILE_EOF(1) = 1, "FILE_EOF am Ende"
ASSERT FILE_POSITION(1) = 29, "FILE_POSITION am Ende"
FILE_CLOSE 1

' --------------------------------------------------------- suchen
ASSERT FILE_OPEN(1, bin$, 1) = 1, "FILE_OPEN erneut lesen"
FILE_SEEK 1, 0, 0
ASSERT FILE_POSITION(1) = 0, "FILE_SEEK Anfang"
ASSERT FILE_EOF(1) = 0, "FILE_EOF am Anfang"
FILE_READ_BYTE 1, b
ASSERT b = -56, "FILE_READ_BYTE nach FILE_SEEK"

FILE_SEEK 1, -1, -1
ASSERT FILE_POSITION(1) = 28, "FILE_SEEK Ende"
readEnd = 0
FILE_READ_UBYTE 1, readEnd
ASSERT readEnd = 99, "letztes Byte ist c"

FILE_SEEK 1, -4, 1
ASSERT FILE_POSITION(1) = 25, "FILE_SEEK relativ zur Position"
FILE_READ_UBYTE 1, readEnd
ASSERT readEnd = 192, "Byte aus dem Float"
FILE_CLOSE 1

' --------------------------------------------------------- zeilen
ASSERT FILE_OPEN(2, lin$, 0) = 1, "FILE_OPEN Zeilen schreiben"
FILE_WRITE_LINE 2, "eins"
FILE_WRITE_LINE 2, "zwei"
FILE_WRITE_STR 2, "ohne newline"
FILE_CLOSE 2
ASSERT FILE_SIZE(lin$) = 24, "FILE_WRITE_LINE schreibt CRLF"

ASSERT FILE_OPEN(2, lin$, 1) = 1, "FILE_OPEN Zeilen lesen"
FILE_READ_LINE 2, zeile$
ASSERT zeile$ = "eins", "FILE_READ_LINE erste Zeile"
FILE_READ_LINE 2, zeile$
ASSERT zeile$ = "zwei", "FILE_READ_LINE zweite Zeile"
FILE_READ_LINE 2, zeile$
ASSERT zeile$ = "ohne newline", "FILE_READ_LINE ohne Zeilenende"
ASSERT FILE_EOF(2) = 1, "FILE_EOF nach letzter Zeile"
FILE_READ_LINE 2, zeile$
ASSERT zeile$ = "", "FILE_READ_LINE am Ende leer"
FILE_CLOSE 2

' ------------------------------------------------------ anhaengen
ASSERT FILE_OPEN(5, app$, 0) = 1, "Datei fuer Anhaengen"
FILE_WRITE_LINE 5, "eins"
FILE_CLOSE 5
ASSERT FILE_OPEN(5, app$, -1) = 1, "FILE_OPEN anhaengen"
FILE_WRITE_LINE 5, "zwei"
FILE_CLOSE 5
ASSERT FILE_SIZE(app$) = 12, "FILE_SIZE nach dem Anhaengen"
ASSERT FILE_OPEN(5, app$, 1) = 1, "FILE_OPEN zum Pruefen"
FILE_READ_LINE 5, zeile$
ASSERT zeile$ = "eins", "erste Zeile vor dem Anhaengen"
FILE_READ_LINE 5, zeile$
ASSERT zeile$ = "zwei", "angehaengte Zeile"
ASSERT FILE_EOF(5) = 1, "Ende nach zwei Zeilen"
FILE_CLOSE 5

' ------------------------------------------------- Dateioperationen
FILE_COPY lin$, cpy$
ASSERT FILE_EXISTS(cpy$) = 1, "FILE_COPY"
ASSERT FILE_SIZE(cpy$) = FILE_SIZE(lin$), "Kopie ist gleich gross"
FILE_RENAME cpy$, mov$
ASSERT FILE_EXISTS(mov$) = 1 AND FILE_EXISTS(cpy$) = 0, "FILE_RENAME"
FILE_DELETE mov$
ASSERT FILE_EXISTS(mov$) = 0, "FILE_DELETE"

' ---------------------------------------------------------- Ordner
ordner$ = ENV$("TEMP") + "/gbx-fileio-test"
DIR_MAKE ordner$
ASSERT FILE_OPEN(4, ordner$ + "/drin.bin", 0) = 1, "Datei im neuen Ordner"
FILE_WRITE_BYTE 4, 7
FILE_CLOSE 4
ASSERT FILE_EXISTS(ordner$ + "/drin.bin") = 1, "Datei im Ordner gefunden"
FILE_DELETE ordner$ + "/drin.bin"

' ---------------------------------------------------------- Fehler
ASSERT FILE_OPEN(9, "gibt_es_nicht.bin", 1) = 0, "FILE_OPEN fehlende Datei"

' -------------------------------------------------------- aufraeumen
FILE_DELETE bin$
FILE_DELETE lin$
FILE_DELETE app$
STDOUT "DATEITEST FERTIG" + CHR$(10)
