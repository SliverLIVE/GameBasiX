' ============================================================
' GameBasiX - Tests fuer Netzwerk (TCP und UDP)
'
'   gbx --headless --tests tests/net_tests.gbx
'
' Alles laeuft im selben Prozess ueber 127.0.0.1: der Server
' nimmt seine eigene Verbindung an, und der UDP-Socket schickt
' sich selbst ein Paket. Damit braucht der Test kein zweites
' Programm und keinen festen Port.
' ============================================================

' ------------------------------------------------------------- TCP
srv = NET_LISTEN(0)
ASSERT srv > 0, "NET_LISTEN auf einem freien Port"
port = NET_PORT(srv)
ASSERT port > 0, "NET_PORT nennt den gebundenen Port"
ASSERT LEN(NET_IP$()) > 0, "NET_IP$ liefert eine Adresse"

cli = NET_CONNECT("127.0.0.1", port, 2000)
ASSERT cli > 0, "NET_CONNECT zu 127.0.0.1"

conn = 0
t = ELAPSED_TIME()
WHILE conn = 0 AND ELAPSED_TIME() - t < 3000
  conn = NET_ACCEPT(srv)
  SLEEP 1
WEND
ASSERT conn > 0, "NET_ACCEPT nimmt die Verbindung an"
ASSERT INSTR(NET_PEER$(conn), "127.0.0.1") = 0, "NET_PEER$ nennt die Gegenstelle"
ASSERT NET_CONNECTED(conn) = 1, "NET_CONNECTED auf einer offenen Verbindung"
ASSERT NET_PENDING(conn) = 0, "NET_PENDING ohne anliegende Daten"

ASSERT NET_SEND(cli, "hallo") = 5, "NET_SEND meldet die Bytes"

msg$ = ""
t = ELAPSED_TIME()
WHILE msg$ = "" AND ELAPSED_TIME() - t < 3000
  msg$ = NET_RECV$(conn)
  SLEEP 1
WEND
ASSERT msg$ = "hallo", "NET_RECV$ liest die gesendeten Bytes"
ASSERT NET_PENDING(conn) = 0, "NET_PENDING nach dem Lesen"

NET_SEND conn, "antwort"
reply$ = ""
t = ELAPSED_TIME()
WHILE reply$ = "" AND ELAPSED_TIME() - t < 3000
  reply$ = NET_RECV$(cli)
  SLEEP 1
WEND
ASSERT reply$ = "antwort", "Daten fliessen in beide Richtungen"
ASSERT NET_RECV$(cli) = "", "NET_RECV$ ohne Daten ist leer"

ASSERT NET_CLOSE(conn) = 1, "NET_CLOSE schliesst die angenommene Verbindung"
closed = 0
t = ELAPSED_TIME()
WHILE closed = 0 AND ELAPSED_TIME() - t < 3000
  IF NET_CONNECTED(cli) = 0 THEN closed = 1
  SLEEP 1
WEND
ASSERT closed = 1, "NET_CONNECTED merkt, dass die Gegenstelle schliesst"
ASSERT NET_CLOSE(cli) = 1, "NET_CLOSE schliesst den Client"

' ----------------------------------------------------- Fehlerfaelle
busy = NET_LISTEN(port)
ASSERT busy = 0, "NET_LISTEN auf einem belegten Port scheitert"
ASSERT LEN(NET_ERROR$()) > 0, "NET_ERROR$ nennt den Grund"
ASSERT NET_CLOSE(srv) = 1, "NET_CLOSE schliesst den Server"

dead = NET_CONNECT("127.0.0.1", port, 500)
ASSERT dead = 0, "NET_CONNECT auf einem geschlossenen Port scheitert"
ASSERT LEN(NET_ERROR$()) > 0, "NET_ERROR$ nach fehlgeschlagener Verbindung"

' ------------------------------------------------------------- UDP
u = UDP_OPEN(0)
ASSERT u > 0, "UDP_OPEN auf einem freien Port"
up = UDP_PORT(u)
ASSERT up > 0, "UDP_PORT nennt den gebundenen Port"
ASSERT UDP_SEND(u, "127.0.0.1", up, "ping") = 1, "UDP_SEND an sich selbst"

pkt$ = ""
t = ELAPSED_TIME()
WHILE pkt$ = "" AND ELAPSED_TIME() - t < 3000
  pkt$ = UDP_RECV$(u)
  SLEEP 1
WEND
ASSERT pkt$ = "ping", "UDP_RECV$ liest das Paket"
ASSERT INSTR(UDP_FROM$(u), "127.0.0.1") = 0, "UDP_FROM$ nennt den Absender"
ASSERT UDP_RECV$(u) = "", "UDP_RECV$ ohne Paket ist leer"
ASSERT UDP_CLOSE(u) = 1, "UDP_CLOSE"

STDOUT "NETZWERKTEST FERTIG" + CHR$(10)
