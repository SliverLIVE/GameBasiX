' ============================================================
' GameBasiX - Befehlstests
'
' Jeder eingebaute Befehl wird mindestens einmal mit minimalen
' Argumenten aufgerufen. Wo das Ergebnis feststeht, prueft ein
' ASSERT den Wert.
'
' Aufrufe (macht tools/check_commands.py):
'   gbx --headless --tests tests/command_tests.gbx
'       ohne Fenster; KEY_WAIT, MOUSE_WAIT und WAIT_INPUT kehren
'       sofort zurueck.
'   SDL_VIDEODRIVER=dummy gbx tests/command_tests.gbx
'       mit Renderer; erst damit laufen SPRITE_GRAB, SCREEN_SAVE_BMP und
'       die Bildschirm-Funktionen wirklich durch.
'
' Nicht automatisierbar: INPUT wartet auf Tastatureingaben im
' Fenster. STDIN$ liest nur, wenn tools/check_commands.py eine
' Zeile uebergibt (Umgebungsvariable GBX_TEST_STDIN).
' ============================================================

cli$ = COMMAND_LINE$()
headless = INSTR(cli$, "--headless") >= 0 OR INSTR(cli$, "--tests") >= 0

' ---------------------------------------------------------- System
DEBUG "DEBUG-Ausgabe"
STDOUT "STDOUT-Ausgabe" + CHR$(10)
STDERR "STDERR-Ausgabe" + CHR$(10)

IF ENV$("GBX_TEST_STDIN") = "1" THEN
  zeile$ = STDIN$()
  ASSERT zeile$ = "testzeile", "STDIN$ liest eine Zeile"
ENDIF

SLEEP 0
ASSERT DELTA_TIME() >= 0, "DELTA_TIME"
ASSERT ELAPSED_TIME() >= 0, "ELAPSED_TIME"
ASSERT INSTR(cli$, "command_tests") >= 0, "COMMAND_LINE$"
ASSERT SOURCE_LINE() > 0, "SOURCE_LINE"
ASSERT INSTR(LCASE$(SOURCE_FILE$()), "command_tests.gbx") >= 0, "SOURCE_FILE$"
ASSERT LEN(PLATFORM_INFO$("os")) > 0, "PLATFORM_INFO$ os"
ASSERT PLATFORM_INFO$("version") = "SDL3", "PLATFORM_INFO$ version"
SET_ENV "GBX_CMD_TEST", "42"
ASSERT ENV$("GBX_CMD_TEST") = "42", "SET_ENV/ENV$"
ASSERT TRUE, "ASSERT selbst"
SOUND_STOP_ALL
ALLOW_ESCAPE 0
ALLOW_ESCAPE 1
SET_SYSTEM_POINTER 0
SET_SYSTEM_POINTER 1

' Blockierende Befehle nur ohne Fenster: dort kehren sie sofort zurueck.
IF headless = TRUE THEN
  KEY_WAIT
  MOUSE_WAIT
  WAIT_INPUT
ENDIF

' ------------------------------------------------- Fenster und Bildschirm
SCREEN_SET 320, 240, 0
WINDOW_TITLE "GBX Befehlstests"
ASSERT SCREEN_WIDTH() = 320, "SCREEN_SET/SCREEN_WIDTH"
ASSERT SCREEN_HEIGHT() = 240, "SCREEN_HEIGHT"
SCREEN_SIZE sw, sh
ASSERT sw = 320 AND sh = 240, "SCREEN_SIZE"
DESKTOP_SIZE dw, dh
ASSERT dw > 0 AND dh > 0, "DESKTOP_SIZE"
ASSERT SCREEN_FULLSCREEN() = 0, "SCREEN_FULLSCREEN"
SET_VIEWPORT 0, 0, 100, 80
VIEWPORT vx, vy, vw, vh
ASSERT vx = 0 AND vy = 0 AND vw = 100 AND vh = 80, "SET_VIEWPORT/VIEWPORT"
SET_VIEWPORT 0, 0, 0, 0
SCREEN_SCALE 640, 480
SCREEN_SCALE 0, 0
SET_SMOOTHING 1
SET_SMOOTHING 0
SET_ALPHA_MODE 0
SET_ALPHA_TEST 0
SET_COLOR_KEY RGB(0, 0, 0)
TEXT_COLOR RGB(255, 255, 255)
SCREEN_CLEAR RGB(0, 0, 64)
SCREEN_BLACK
SCREEN_SHOW
LIMIT_FPS 60, 0
ASSERT RGB(1, 2, 3) = 66051, "RGB"

' ------------------------------------------------------------- Zeichnen
DRAW_LINE 0, 0, 10, 10, RGB(255, 0, 0)
DRAW_RECT 2, 2, 20, 10, RGB(0, 255, 0)
DRAW_RECT_BORDER 0, 0, 30, 30, RGB(0, 0, 255)
DRAW_CIRCLE 40, 40, 10, RGB(255, 255, 0)
DRAW_CIRCLE_FILLED 40, 40, 8, RGB(0, 255, 255)
PIXEL_SET 5, 5, RGB(1, 2, 3)
IF headless = TRUE THEN
  px = PIXEL_GET(5, 5)
  ASSERT px >= 0, "PIXEL_GET"
ELSE
  ASSERT PIXEL_GET(5, 5) = RGB(1, 2, 3), "PIXEL_SET/PIXEL_GET"
ENDIF

POLY_BEGIN -1, 0
POLY_POINT 0, 0, 0, 0, RGB(255, 255, 255)
POLY_POINT 10, 0, 0, 0, RGB(255, 255, 255)
POLY_STRIP
POLY_POINT 0, 10, 0, 0, RGB(255, 255, 255)
POLY_END

' -------------------------------------------------------------- Sprites
sprite1 = SPRITE_NEW()
ASSERT sprite1 >= 0, "SPRITE_NEW"
sound1 = SOUND_NEW()
ASSERT sound1 >= 0, "SOUND_NEW"
font1 = FONT_NEW()
ASSERT font1 >= 0, "FONT_NEW"
screen1 = SCREEN_NEW()
ASSERT screen1 >= 0, "SCREEN_NEW"

SPRITE_LOAD "../examples/03_sprites/assets/ball.png", 1
SPRITE_SIZE 1, bw, bh
ASSERT bw > 0 AND bh > 0, "SPRITE_LOAD/SPRITE_SIZE"
SPRITE_LOAD "../examples/03_sprites/assets/sparkle.png", 3
ANIM_LOAD "../examples/03_sprites/assets/ball.png", 2, bw, bh
ANIM_SET_TILES 2, bw, bh

SPRITE_DRAW 1, 30, 30
SPRITE_DRAW_ROTATED 1, 30, 30, 45
SPRITE_DRAW_ROTATED_SCALED 1, 30, 30, 45, 100
SPRITE_DRAW_SCALED 1, 30, 30, 100, 100
SPRITE_DRAW_STRETCHED 1, 30, 30, bw * 2, bh * 2
ANIM_DRAW 2, 0, 60, 30
ANIM_DRAW_ROTATED_SCALED 2, 0, 60, 30, 30, 100
ANIM_DRAW_STRETCHED 2, 0, 60, 30, bw, bh

ASSERT SPRITE_COLLIDE(1, 0, 0, 1, 0, 0) = 1, "SPRITE_COLLIDE Treffer"
ASSERT SPRITE_COLLIDE(1, 0, 0, 3, 1000, 1000) = 0, "SPRITE_COLLIDE daneben"
ASSERT ANIM_COLLIDE(2, 0, 0, 0, 2, 0, 0, 0) = 1, "ANIM_COLLIDE"
ASSERT RECT_COLLIDE(0, 0, 10, 10, 5, 5, 10, 10) = 1, "RECT_COLLIDE Treffer"
ASSERT RECT_COLLIDE(0, 0, 10, 10, 50, 50, 10, 10) = 0, "RECT_COLLIDE daneben"

SPRITE_SAVE "out_commands.png", 1
SPRITE_LOAD "out_commands.png", 4
SPRITE_SIZE 4, bw2, bh2
ASSERT bw2 = bw AND bh2 = bh, "SPRITE_SAVE/SPRITE_LOAD"

' ------------------------------------------- Bildpuffer und virtuelle Screens
IF headless = FALSE THEN
  SPRITE_GRAB 5, 0, 0, 16, 16
  SPRITE_SIZE 5, gw, gh
  ASSERT gw = 16 AND gh = 16, "SPRITE_GRAB"
  BACKGROUND_LOAD "../examples/03_sprites/assets/ball.png"
  SCREEN_TO_BACKGROUND
  SCREEN_FADE "../examples/03_sprites/assets/ball.png", 1
  SCREEN_CREATE 0, screen1, 64, 64
  SCREEN_USE 0
  SCREEN_USE -1
  SCREEN_SAVE_BMP "out_commands.bmp"
  BACKGROUND_LOAD "out_commands.bmp"
  ASSERT PIXEL_GET(0, 0) >= 0, "SCREEN_SAVE_BMP/BACKGROUND_LOAD"
ENDIF

' ----------------------------------------------------------------- Text
FONT_LOAD "assets/font.png", 7
FONT_SET 7, 1
ASSERT FONT_CURRENT() = 7, "FONT_LOAD/FONT_SET/FONT_CURRENT"
FONT_SIZE fw, fh
ASSERT fw > 0 AND fh > 0, "FONT_SIZE"
PRINT "GBX", 10, 10
TEXT_DRAW "GBX", 10, 30, RGB(255, 255, 0)
' Zurueck auf den Standard-Font (existiert nur mit Fenster, im
' Headless-Modus bleibt FONT_SET deshalb wirkungslos).
FONT_SET 0, 1

' ---------------------------------------------------------------- Eingabe
ASSERT KEY_DOWN(KEY_ESC) = 0, "KEY_DOWN"
ASSERT KEY_PRESSED(KEY_A) = 0, "KEY_PRESSED"
ASSERT INKEY$() = "", "INKEY$"
ASSERT MOUSE_COUNT() >= 0, "MOUSE_COUNT"
MOUSE_STATE mx, my, mb1, mb2
ASSERT mx >= 0 AND my >= 0, "MOUSE_STATE"
ASSERT MOUSE_AXIS(0) >= 0, "MOUSE_AXIS"
ASSERT MOUSE_PRESSED(1) = 0, "MOUSE_PRESSED"
MOUSE_MOVE 100, 100

' ------------------------------------------------------------------ Sound
SOUND_LOAD "assets/beep.wav", 1
kanal = SOUND_PLAY(1, 0, 1)
ASSERT kanal >= 0, "SOUND_PLAY"
ASSERT SOUND_PLAYING(kanal) = 0 OR SOUND_PLAYING(kanal) = 1, "SOUND_PLAYING"
SOUND_STOP kanal
MUSIC_PLAY "assets/beep.wav", 0
ASSERT MUSIC_PLAYING() = 1, "MUSIC_PLAY/MUSIC_PLAYING"
MUSIC_VOLUME 0.5
MUSIC_PAUSE 1
MUSIC_PAUSE 0
MUSIC_STOP
ASSERT MUSIC_PLAYING() = 0, "MUSIC_STOP"

' MP3 laeuft durch denselben Mixer (Dekoder: minimp3, derselbe Weg wie WAV)
SOUND_LOAD "assets/beep.mp3", 2
kanal = SOUND_PLAY(2, 0, 1)
ASSERT kanal >= 0, "SOUND_PLAY mit MP3"
SOUND_STOP kanal
MUSIC_PLAY "assets/beep.mp3", 0
ASSERT MUSIC_PLAYING() = 1, "MUSIC_PLAY mit MP3"
MUSIC_VOLUME 0.25
MUSIC_STOP
ASSERT MUSIC_PLAYING() = 0, "MUSIC_STOP nach MP3"

' Eine Datei ohne Audio muss eine Meldung bringen, die die Formate nennt
fehler$ = ""
TRY
  SOUND_LOAD "assets/notaudio.txt", 3
CATCH e$
  fehler$ = e$
FINALLY
ASSERT INSTR(fehler$, "WAV") >= 0 OR INSTR(fehler$, "MP3") >= 0, "SOUND_LOAD lehnt Nicht-Audio ab"

' ------------------------------------------------------------------ Mathe
ASSERT ABS(-3) = 3, "ABS"
ASSERT SGN(-2) = -1, "SGN"
ASSERT SQR(16) = 4, "SQR"
ASSERT ABS(SIN(90) - 1) < 0.0001, "SIN"
ASSERT ABS(COS(0) - 1) < 0.0001, "COS"
ASSERT ABS(TAN(45) - 1) < 0.0001, "TAN"
ASSERT ABS(ASIN(1) - 90) < 0.0001, "ASIN"
ASSERT ABS(ACOS(1)) < 0.0001, "ACOS"
ASSERT ABS(ATAN(1, 1) - 45) < 0.0001, "ATAN"
ASSERT FLOOR(2.9) = 2, "FLOOR"
ASSERT CEIL(2.1) = 3, "CEIL"
ASSERT POW(2, 8) = 256, "POW"
ASSERT ABS(LOGN(1)) < 0.0001, "LOGN"
ASSERT MOD(7, 3) = 1, "MOD"
ASSERT ABS(FMOD(7.5, 2) - 1.5) < 0.0001, "FMOD"
ASSERT MIN(2, 5) = 2, "MIN"
ASSERT MAX(2, 5) = 5, "MAX"
RND_SEED 1
r = RND(5)
ASSERT r >= 0 AND r <= 5, "RND"
ASSERT INTEGER(-2.7) = -2, "INTEGER"
ASSERT INTEGER64(7.9) = 7, "INTEGER64"
ASSERT NUMBER("12.5") = 12.5, "NUMBER"
ASSERT SHL(1, 3) = 8, "SHL"
ASSERT SHR(8, 3) = 1, "SHR"
ASSERT BAND(6, 3) = 2, "BAND"
ASSERT BOR(4, 1) = 5, "BOR"
ASSERT BXOR(6, 3) = 5, "BXOR"
ASSERT BNOT(0) = -1, "BNOT"

' ---------------------------------------------------------------- Strings
ASSERT LEN("abc") = 3, "LEN"
ASSERT ASC("A") = 65, "ASC"
ASSERT CHR$(66) = "B", "CHR$"
ASSERT HEX$(255) = "FF", "HEX$"
ASSERT LEFT$("abc", 2) = "ab", "LEFT$"
ASSERT RIGHT$("abc", 2) = "bc", "RIGHT$"
ASSERT MID$("abcd", 1, 2) = "bc", "MID$"
ASSERT INSTR("abc", "b") = 1, "INSTR"
ASSERT INSTR_REVERSE("a.b.c", ".") = 3, "INSTR_REVERSE"
ASSERT REPLACE$("a-b", "-", "+") = "a+b", "REPLACE$"
ASSERT UCASE$("ab") = "AB", "UCASE$"
ASSERT LCASE$("AB") = "ab", "LCASE$"
ASSERT LTRIM$("  x") = "x", "LTRIM$"
ASSERT RTRIM$("x  ") = "x", "RTRIM$"
ASSERT TRIM$("  x  ") = "x", "TRIM$"
ASSERT FORMAT$(6, 2, 3.14159) = "  3.14", "FORMAT$"
ASSERT STR$("42") = "42", "STR$"
ASSERT VAL("42.5") = 42.5, "VAL"
ASSERT LEN("abc", TRUE) > 0, "LEN mit Pixelbreite"

' --------------------------------------------------------------- Dateien
tmpdir$ = ENV$("TEMP") + "/gbx-cmd-tests"
DIR_MAKE tmpdir$
cf$ = "cmd_temp.bin"
IF FILE_EXISTS(cf$) THEN FILE_DELETE cf$
ASSERT FILE_OPEN(1, cf$, 0) = 1, "FILE_OPEN schreiben"
FILE_WRITE_BYTE 1, 1
FILE_WRITE_UBYTE 1, 2
FILE_WRITE_WORD 1, 3
FILE_WRITE_UWORD 1, 4
FILE_WRITE_LONG 1, 5
FILE_WRITE_ULONG 1, 6
FILE_WRITE_DOUBLE 1, 7.5
FILE_WRITE_FLOAT 1, 8.5
FILE_WRITE_STR 1, "x"
FILE_WRITE_LINE 1, "y"
FILE_CLOSE 1
ASSERT FILE_SIZE(cf$) = 30, "FILE_SIZE"
ASSERT FILE_EXISTS(cf$) = 1, "FILE_EXISTS"
ASSERT FILE_OPEN(1, cf$, 1) = 1, "FILE_OPEN lesen"
FILE_READ_BYTE 1, r1
FILE_READ_UBYTE 1, r2
FILE_READ_WORD 1, r3
FILE_READ_UWORD 1, r4
FILE_READ_LONG 1, r5
FILE_READ_ULONG 1, r6
FILE_READ_DOUBLE 1, r7
FILE_READ_FLOAT 1, r8
FILE_READ_STR 1, r9$, 1
FILE_READ_LINE 1, r10$
ASSERT r1 = 1 AND r2 = 2 AND r3 = 3 AND r4 = 4 AND r5 = 5 AND r6 = 6, "READ Ganzzahlen"
ASSERT r7 = 7.5 AND r8 = 8.5 AND r9$ = "x" AND r10$ = "y", "READ Zahlen und Text"
ASSERT FILE_EOF(1) = 1, "FILE_EOF"
FILE_SEEK 1, 0, 0
ASSERT FILE_POSITION(1) = 0, "FILE_POSITION"
FILE_CLOSE 1
FILE_COPY cf$, tmpdir$ + "/kopie.bin"
ASSERT FILE_EXISTS(tmpdir$ + "/kopie.bin") = 1, "FILE_COPY"
FILE_RENAME cf$, tmpdir$ + "/verschoben.bin"
ASSERT FILE_EXISTS(tmpdir$ + "/verschoben.bin") = 1, "FILE_RENAME"
FILE_DELETE tmpdir$ + "/kopie.bin"
FILE_DELETE tmpdir$ + "/verschoben.bin"

' ------------------------------------------------------------- Netzwerk
nl = NET_LISTEN(0)
ASSERT nl > 0, "NET_LISTEN"
ASSERT NET_PORT(nl) > 0, "NET_PORT"
ASSERT LEN(NET_IP$()) > 0, "NET_IP$"
nc = NET_CONNECT("127.0.0.1", NET_PORT(nl), 2000)
ASSERT nc > 0, "NET_CONNECT"
ns = 0
t = ELAPSED_TIME()
WHILE ns = 0 AND ELAPSED_TIME() - t < 3000
  ns = NET_ACCEPT(nl)
  SLEEP 1
WEND
ASSERT ns > 0, "NET_ACCEPT"
ASSERT NET_SEND(nc, "x") = 1, "NET_SEND"
ASSERT NET_CONNECTED(ns) = 1, "NET_CONNECTED"
ASSERT INSTR(NET_PEER$(ns), "127.0.0.1") = 0, "NET_PEER$"
ASSERT NET_PENDING(ns) >= 0, "NET_PENDING"
rx$ = ""
t = ELAPSED_TIME()
WHILE rx$ = "" AND ELAPSED_TIME() - t < 3000
  rx$ = NET_RECV$(ns)
  SLEEP 1
WEND
ASSERT rx$ = "x", "NET_RECV$"
NET_CLOSE ns
NET_CLOSE nc
NET_CLOSE nl
ASSERT LEN(NET_ERROR$()) >= 0, "NET_ERROR$"

nu = UDP_OPEN(0)
ASSERT nu > 0, "UDP_OPEN"
ASSERT UDP_PORT(nu) > 0, "UDP_PORT"
ASSERT UDP_SEND(nu, "127.0.0.1", UDP_PORT(nu), "u") = 1, "UDP_SEND"
ur$ = ""
t = ELAPSED_TIME()
WHILE ur$ = "" AND ELAPSED_TIME() - t < 3000
  ur$ = UDP_RECV$(nu)
  SLEEP 1
WEND
ASSERT ur$ = "u", "UDP_RECV$"
ASSERT LEN(UDP_FROM$(nu)) > 0, "UDP_FROM$"
UDP_CLOSE nu

' ---------------------------------------------------------------- Steam
' Ohne steam_api bleiben die Befehle bei 0; mit Bibliothek duerfen sie
' auch Werte liefern. Beides ist in Ordnung.
sok = STEAM_INIT()
ASSERT sok = 0 OR sok = 1, "STEAM_INIT"
ASSERT STEAM_READY() = sok, "STEAM_READY"
ASSERT STEAM_RUN() = sok, "STEAM_RUN"
ASSERT STEAM_APP_ID() >= 0, "STEAM_APP_ID"
ASSERT STEAM_FRIENDS() >= 0, "STEAM_FRIENDS"
ASSERT STEAM_FRIEND_STATE(0) >= 0, "STEAM_FRIEND_STATE"
ASSERT LEN(STEAM_NAME$()) >= 0, "STEAM_NAME$"
ASSERT LEN(STEAM_ID$()) >= 0, "STEAM_ID$"
ASSERT LEN(STEAM_FRIEND_ID$(0)) >= 0, "STEAM_FRIEND_ID$"
ASSERT LEN(STEAM_FRIEND_NAME$(0)) >= 0, "STEAM_FRIEND_NAME$"
ASSERT STEAM_P2P_SEND("76561198000000000", "x") >= 0, "STEAM_P2P_SEND"
ASSERT STEAM_P2P_AVAILABLE(0) >= 0, "STEAM_P2P_AVAILABLE"
ASSERT LEN(STEAM_P2P_RECV$(0)) >= 0, "STEAM_P2P_RECV$"
ASSERT LEN(STEAM_P2P_FROM$()) >= 0, "STEAM_P2P_FROM$"
ASSERT STEAM_P2P_STATE("76561198000000000") >= 0, "STEAM_P2P_STATE"
ASSERT STEAM_P2P_ACCEPT("76561198000000000") >= 0, "STEAM_P2P_ACCEPT"
ASSERT STEAM_P2P_CLOSE("76561198000000000") >= 0, "STEAM_P2P_CLOSE"
ASSERT LEN(STEAM_ERROR$()) >= 0, "STEAM_ERROR$"
STEAM_SHUTDOWN

' --------------------------------------------------------------- Arrays
DIM teile$[0]
cnt = SPLIT_STRING("a,b,c", teile$[], ",")
ASSERT cnt = 3 AND teile$[1] = "b", "SPLIT_STRING"
ASSERT JOIN$(teile$[], "-") = "a-b-c", "JOIN$"
ASSERT JOIN$(teile$[], "-", 1, 1) = "b", "JOIN$ ab Start mit Anzahl"
DIM zahlen[4]
ASSERT ARRAY_BOUNDS(zahlen[], 0) = 4, "ARRAY_BOUNDS"
DIMDATA werte[], 3, 4, 5
ASSERT ARRAY_BOUNDS(werte[], 0) = 3 AND werte[2] = 5, "DIMDATA"

STDOUT "BEFEHLSTEST FERTIG" + CHR$(10)
END
