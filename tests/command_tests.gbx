' ============================================================
' GameBasiX - Befehlstests
'
' Jeder eingebaute Befehl wird mindestens einmal mit minimalen
' Argumenten aufgerufen. Wo das Ergebnis feststeht, prueft ein
' ASSERT den Wert.
'
' Aufrufe (macht tools/check_commands.py):
'   gbx --headless --tests tests/command_tests.gbx
'       ohne Fenster; KEYWAIT, MOUSEWAIT und HIBERNATE kehren
'       sofort zurueck.
'   SDL_VIDEODRIVER=dummy gbx tests/command_tests.gbx
'       mit Renderer; erst damit laufen GRABSPRITE, SAVEBMP und
'       die Bildschirm-Funktionen wirklich durch.
'
' Nicht automatisierbar: INPUT wartet auf Tastatureingaben im
' Fenster. STDIN$ liest nur, wenn tools/check_commands.py eine
' Zeile uebergibt (Umgebungsvariable GBX_TEST_STDIN).
' ============================================================

cli$ = GETCOMMANDLINE$()
headless = INSTR(cli$, "--headless") >= 0 OR INSTR(cli$, "--tests") >= 0

' ---------------------------------------------------------- System
DEBUG "DEBUG-Ausgabe"
STDOUT "STDOUT-Ausgabe" + CHR$(10)
STDERR "STDERR-Ausgabe" + CHR$(10)

IF GETENV$("GBX_TEST_STDIN") = "1" THEN
  zeile$ = STDIN$()
  ASSERT zeile$ = "testzeile", "STDIN$ liest eine Zeile"
ENDIF

SLEEP 0
ASSERT GETTIMER() >= 0, "GETTIMER"
ASSERT GETTIMERALL() >= 0, "GETTIMERALL"
ASSERT INSTR(cli$, "command_tests") >= 0, "GETCOMMANDLINE$"
ASSERT CODELINE() > 0, "CODELINE"
ASSERT INSTR(LCASE$(CODEFILE$()), "command_tests.gbx") >= 0, "CODEFILE$"
ASSERT LEN(PLATFORMINFO$("os")) > 0, "PLATFORMINFO$ os"
ASSERT PLATFORMINFO$("version") = "SDL3", "PLATFORMINFO$ version"
PUTENV "GBX_CMD_TEST", "42"
ASSERT GETENV$("GBX_CMD_TEST") = "42", "PUTENV/GETENV$"
ASSERT TRUE, "ASSERT selbst"
HUSH
ALLOWESCAPE 0
ALLOWESCAPE 1
SYSTEMPOINTER 0
SYSTEMPOINTER 1

' Blockierende Befehle nur ohne Fenster: dort kehren sie sofort zurueck.
IF headless = TRUE THEN
  KEYWAIT
  MOUSEWAIT
  HIBERNATE
ENDIF

' ------------------------------------------------- Fenster und Bildschirm
SETSCREEN 320, 240, 0
SETWINDOWTITLE "GBX Befehlstests"
ASSERT GETSCREENWIDTH() = 320, "SETSCREEN/GETSCREENWIDTH"
ASSERT GETSCREENHEIGHT() = 240, "GETSCREENHEIGHT"
GETSCREENSIZE sw, sh
ASSERT sw = 320 AND sh = 240, "GETSCREENSIZE"
GETDESKTOPSIZE dw, dh
ASSERT dw > 0 AND dh > 0, "GETDESKTOPSIZE"
ASSERT ISFULLSCREEN() = 0, "ISFULLSCREEN"
VIEWPORT 0, 0, 100, 80
GETVIEWPORT vx, vy, vw, vh
ASSERT vx = 0 AND vy = 0 AND vw = 100 AND vh = 80, "VIEWPORT/GETVIEWPORT"
VIEWPORT 0, 0, 0, 0
PRESCALER 640, 480
PRESCALER 0, 0
SMOOTHSHADING 1
SMOOTHSHADING 0
ALPHAMODE 0
ALPHATESTING 0
SETTRANSPARENCY RGB(0, 0, 0)
SETTEXTCOLOR RGB(255, 255, 255)
CLEARSCREEN RGB(0, 0, 64)
BLACKSCREEN
SHOWSCREEN
LIMITFPS 60, 0
ASSERT RGB(1, 2, 3) = 66051, "RGB"

' ------------------------------------------------------------- Zeichnen
DRAWLINE 0, 0, 10, 10, RGB(255, 0, 0)
DRAWRECT 2, 2, 20, 10, RGB(0, 255, 0)
DRAWBORDER 0, 0, 30, 30, RGB(0, 0, 255)
DRAWCIRCLE 40, 40, 10, RGB(255, 255, 0)
DRAWFILLEDCIRCLE 40, 40, 8, RGB(0, 255, 255)
SETPIXEL 5, 5, RGB(1, 2, 3)
IF headless = TRUE THEN
  px = GETPIXEL(5, 5)
  ASSERT px >= 0, "GETPIXEL"
ELSE
  ASSERT GETPIXEL(5, 5) = RGB(1, 2, 3), "SETPIXEL/GETPIXEL"
ENDIF

STARTPOLY -1, 0
POLYVECTOR 0, 0, 0, 0, RGB(255, 255, 255)
POLYVECTOR 10, 0, 0, 0, RGB(255, 255, 255)
POLYNEWSTRIP
POLYVECTOR 0, 10, 0, 0, RGB(255, 255, 255)
ENDPOLY

' -------------------------------------------------------------- Sprites
sprite1 = GENSPRITE()
ASSERT sprite1 >= 0, "GENSPRITE"
sound1 = GENSOUND()
ASSERT sound1 >= 0, "GENSOUND"
font1 = GENFONT()
ASSERT font1 >= 0, "GENFONT"
screen1 = GENSCREEN()
ASSERT screen1 >= 0, "GENSCREEN"

LOADSPRITE "../examples/03_sprites/assets/ball.png", 1
GETSPRITESIZE 1, bw, bh
ASSERT bw > 0 AND bh > 0, "LOADSPRITE/GETSPRITESIZE"
LOADSPRITE "../examples/03_sprites/assets/sparkle.png", 3
LOADANIM "../examples/03_sprites/assets/ball.png", 2, bw, bh
SETSPRITEANIM 2, bw, bh

DRAWSPRITE 1, 30, 30
ROTOSPRITE 1, 30, 30, 45
ROTOZOOMSPRITE 1, 30, 30, 45, 100
ZOOMSPRITE 1, 30, 30, 100, 100
STRETCHSPRITE 1, 30, 30, bw * 2, bh * 2
DRAWANIM 2, 0, 60, 30
ROTOZOOMANIM 2, 0, 60, 30, 30, 100
STRETCHANIM 2, 0, 60, 30, bw, bh

ASSERT SPRCOLL(1, 0, 0, 1, 0, 0) = 1, "SPRCOLL Treffer"
ASSERT SPRCOLL(1, 0, 0, 3, 1000, 1000) = 0, "SPRCOLL daneben"
ASSERT ANIMCOLL(2, 0, 0, 0, 2, 0, 0, 0) = 1, "ANIMCOLL"
ASSERT BOXCOLL(0, 0, 10, 10, 5, 5, 10, 10) = 1, "BOXCOLL Treffer"
ASSERT BOXCOLL(0, 0, 10, 10, 50, 50, 10, 10) = 0, "BOXCOLL daneben"

SAVESPRITE "out_commands.png", 1
LOADSPRITE "out_commands.png", 4
GETSPRITESIZE 4, bw2, bh2
ASSERT bw2 = bw AND bh2 = bh, "SAVESPRITE/LOADSPRITE"

' ------------------------------------------- Bildpuffer und virtuelle Screens
IF headless = FALSE THEN
  GRABSPRITE 5, 0, 0, 16, 16
  GETSPRITESIZE 5, gw, gh
  ASSERT gw = 16 AND gh = 16, "GRABSPRITE"
  LOADBMP "../examples/03_sprites/assets/ball.png"
  USEASBMP
  BLENDSCREEN "../examples/03_sprites/assets/ball.png", 1
  CREATESCREEN 0, screen1, 64, 64
  USESCREEN 0
  USESCREEN -1
  SAVEBMP "out_commands.bmp"
  LOADBMP "out_commands.bmp"
  ASSERT GETPIXEL(0, 0) >= 0, "SAVEBMP/LOADBMP"
ENDIF

' ----------------------------------------------------------------- Text
LOADFONT "assets/font.png", 7
SETFONT 7, 1
ASSERT GETCURRENTFONT() = 7, "LOADFONT/SETFONT/GETCURRENTFONT"
GETFONTSIZE fw, fh
ASSERT fw > 0 AND fh > 0, "GETFONTSIZE"
PRINT "GBX", 10, 10
DRAWTEXT "GBX", 10, 30, RGB(255, 255, 0)
' Zurueck auf den Standard-Font (existiert nur mit Fenster, im
' Headless-Modus bleibt SETFONT deshalb wirkungslos).
SETFONT 0, 1

' ---------------------------------------------------------------- Eingabe
ASSERT KEY(KEY_ESC) = 0, "KEY"
ASSERT KEYHIT(KEY_A) = 0, "KEYHIT"
ASSERT INKEY$() = "", "INKEY$"
ASSERT GETMOUSECOUNT() >= 0, "GETMOUSECOUNT"
MOUSESTATE mx, my, mb1, mb2
ASSERT mx >= 0 AND my >= 0, "MOUSESTATE"
ASSERT MOUSEAXIS(0) >= 0, "MOUSEAXIS"
ASSERT MOUSEHIT(1) = 0, "MOUSEHIT"
SETMOUSE 100, 100

' ------------------------------------------------------------------ Sound
LOADSOUND "assets/beep.wav", 1
kanal = PLAYSOUND(1, 0, 1)
ASSERT kanal >= 0, "PLAYSOUND"
ASSERT SOUNDPLAYING(kanal) = 0 OR SOUNDPLAYING(kanal) = 1, "SOUNDPLAYING"
STOPSOUND kanal
PLAYMUSIC "assets/beep.wav", 0
ASSERT ISMUSICPLAYING() = 1, "PLAYMUSIC/ISMUSICPLAYING"
MUSICVOLUME 0.5
PAUSEMUSIC 1
PAUSEMUSIC 0
STOPMUSIC
ASSERT ISMUSICPLAYING() = 0, "STOPMUSIC"

' ------------------------------------------------------------------ Mathe
ASSERT ABS(-3) = 3, "ABS"
ASSERT SGN(-2) = -1, "SGN"
ASSERT SQR(16) = 4, "SQR"
ASSERT ABS(SIN(90) - 1) < 0.0001, "SIN"
ASSERT ABS(COS(0) - 1) < 0.0001, "COS"
ASSERT ABS(TAN(45) - 1) < 0.0001, "TAN"
ASSERT ABS(ASIN(1) - 90) < 0.0001, "ASIN"
ASSERT ABS(ACOS(1)) < 0.0001, "ACOS"
ASSERT ABS(ATAN(1, 1) - 45) < 0.0001, "ATAN"
ASSERT FLOOR(2.9) = 2, "FLOOR"
ASSERT CEIL(2.1) = 3, "CEIL"
ASSERT POW(2, 8) = 256, "POW"
ASSERT ABS(LOGN(1)) < 0.0001, "LOGN"
ASSERT MOD(7, 3) = 1, "MOD"
ASSERT ABS(FMOD(7.5, 2) - 1.5) < 0.0001, "FMOD"
ASSERT MIN(2, 5) = 2, "MIN"
ASSERT MAX(2, 5) = 5, "MAX"
SEEDRND 1
r = RND(5)
ASSERT r >= 0 AND r <= 5, "RND"
ASSERT INTEGER(-2.7) = -2, "INTEGER"
ASSERT INTEGER64(7.9) = 7, "INTEGER64"
ASSERT NUMBER("12.5") = 12.5, "NUMBER"
ASSERT ASL(1, 3) = 8, "ASL"
ASSERT ASR(8, 3) = 1, "ASR"
ASSERT BAND(6, 3) = 2, "BAND"
ASSERT BOR(4, 1) = 5, "BOR"
ASSERT BXOR(6, 3) = 5, "BXOR"
ASSERT BNOT(0) = -1, "BNOT"

' ---------------------------------------------------------------- Strings
ASSERT LEN("abc") = 3, "LEN"
ASSERT ASC("A") = 65, "ASC"
ASSERT CHR$(66) = "B", "CHR$"
ASSERT HEX$(255) = "FF", "HEX$"
ASSERT LEFT$("abc", 2) = "ab", "LEFT$"
ASSERT RIGHT$("abc", 2) = "bc", "RIGHT$"
ASSERT MID$("abcd", 1, 2) = "bc", "MID$"
ASSERT INSTR("abc", "b") = 1, "INSTR"
ASSERT REVINSTR("a.b.c", ".") = 3, "REVINSTR"
ASSERT REPLACE$("a-b", "-", "+") = "a+b", "REPLACE$"
ASSERT UCASE$("ab") = "AB", "UCASE$"
ASSERT LCASE$("AB") = "ab", "LCASE$"
ASSERT LTRIM$("  x") = "x", "LTRIM$"
ASSERT RTRIM$("x  ") = "x", "RTRIM$"
ASSERT TRIM$("  x  ") = "x", "TRIM$"
ASSERT FORMAT$(6, 2, 3.14159) = "  3.14", "FORMAT$"
ASSERT STR$("42") = "42", "STR$"
ASSERT VAL("42.5") = 42.5, "VAL"
ASSERT LEN("abc", TRUE) > 0, "LEN mit Pixelbreite"

' --------------------------------------------------------------- Dateien
tmpdir$ = GETENV$("TEMP") + "/gbx-cmd-tests"
MAKEDIR tmpdir$
cf$ = "cmd_temp.bin"
IF FILEEXISTS(cf$) THEN DELETEFILE cf$
ASSERT OPENFILE(1, cf$, 0) = 1, "OPENFILE schreiben"
WRITEBYTE 1, 1
WRITEUBYTE 1, 2
WRITEWORD 1, 3
WRITEUWORD 1, 4
WRITELONG 1, 5
WRITEULONG 1, 6
WRITEIEEE 1, 7.5
WRITESHORTIEEE 1, 8.5
WRITESTR 1, "x"
WRITELINE 1, "y"
CLOSEFILE 1
ASSERT FILESIZE(cf$) = 30, "FILESIZE"
ASSERT FILEEXISTS(cf$) = 1, "FILEEXISTS"
ASSERT OPENFILE(1, cf$, 1) = 1, "OPENFILE lesen"
READBYTE 1, r1
READUBYTE 1, r2
READWORD 1, r3
READUWORD 1, r4
READLONG 1, r5
READULONG 1, r6
READIEEE 1, r7
READSHORTIEEE 1, r8
READSTR 1, r9$, 1
READLINE 1, r10$
ASSERT r1 = 1 AND r2 = 2 AND r3 = 3 AND r4 = 4 AND r5 = 5 AND r6 = 6, "READ Ganzzahlen"
ASSERT r7 = 7.5 AND r8 = 8.5 AND r9$ = "x" AND r10$ = "y", "READ Zahlen und Text"
ASSERT FILEEOF(1) = 1, "FILEEOF"
FILESEEK 1, 0, 0
ASSERT FILEPOSITION(1) = 0, "FILEPOSITION"
CLOSEFILE 1
COPYFILE cf$, tmpdir$ + "/kopie.bin"
ASSERT FILEEXISTS(tmpdir$ + "/kopie.bin") = 1, "COPYFILE"
RENAMEFILE cf$, tmpdir$ + "/verschoben.bin"
ASSERT FILEEXISTS(tmpdir$ + "/verschoben.bin") = 1, "RENAMEFILE"
DELETEFILE tmpdir$ + "/kopie.bin"
DELETEFILE tmpdir$ + "/verschoben.bin"

' --------------------------------------------------------------- Arrays
DIM teile$[0]
cnt = SPLITSTR("a,b,c", teile$[], ",")
ASSERT cnt = 3 AND teile$[1] = "b", "SPLITSTR"
DIM zahlen[4]
ASSERT BOUNDS(zahlen[], 0) = 4, "BOUNDS"
DIMDATA werte[], 3, 4, 5
ASSERT BOUNDS(werte[], 0) = 3 AND werte[2] = 5, "DIMDATA"

STDOUT "BEFEHLSTEST FERTIG" + CHR$(10)
END
