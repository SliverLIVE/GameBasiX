' ============================================================
' Function values - @name passes a FUNCTION around
' Run: gbx examples/25_callbacks/callbacks.gbxproj
'
'   @doubleIt              a reference to a FUNCTION
'   apply(@doubleIt, 7)    as an argument
'   action = @square       kept in a variable
'   action(9)              called through the name
' That makes callbacks straightforward: the same loop computes
' with different functions.
' ============================================================

FUNCTION doubleIt: x
  RETURN x * 2
ENDFUNCTION

FUNCTION square: x
  RETURN x * x
ENDFUNCTION

FUNCTION plus100: x
  RETURN x + 100
ENDFUNCTION

FUNCTION apply: f, x
  RETURN f(x)
ENDFUNCTION

FUNCTION total: f, values
  sum# = 0
  FOR i = 0 TO LEN(values) - 1
    sum# = sum# + f(values[i])
  NEXT
  RETURN sum#
ENDFUNCTION

GLOBAL numbers[5]
numbers[0] = 1 : numbers[1] = 2 : numbers[2] = 3 : numbers[3] = 4 : numbers[4] = 5

GLOBAL action
action = @doubleIt

isFunction% = ISA(action, "function")
value% = apply(action, 7)
sum% = total(action, numbers)

DEBUG "apply(@doubleIt, 7) = " + STR$(value%) + CHR$(10)
DEBUG "total(@doubleIt, 1..5) = " + STR$(sum%) + CHR$(10)
DEBUG "ISA(action, ""function"") = " + STR$(isFunction%) + CHR$(10)

SCREEN_SET 760, 520, 0
WINDOW_TITLE "GameBasiX - function values"
LIMIT_FPS 60

which% = 0

WHILE TRUE
  SCREEN_CLEAR RGB(10, 14, 22)

  TEXT_COLOR RGB(230, 238, 250)
  PRINT "Function values", 50, 24
  TEXT_COLOR RGB(140, 170, 205)
  PRINT "space: next callback, ESC: end", 50, 52

  TEXT_COLOR RGB(120, 200, 160)
  IF which% = 0 THEN
    PRINT "action = @doubleIt   (x * 2)", 50, 104
  ELSEIF which% = 1 THEN
    PRINT "action = @square     (x * x)", 50, 104
  ELSE
    PRINT "action = @plus100    (x + 100)", 50, 104
  ENDIF

  TEXT_COLOR RGB(200, 214, 232)
  PRINT "apply(action, 7)     = " + STR$(apply(action, 7)), 70, 136
  PRINT "action(9)            = " + STR$(action(9)), 70, 162
  PRINT "ISA(action, ""function"") = " + STR$(ISA(action, "function")), 70, 188

  TEXT_COLOR RGB(120, 200, 160)
  PRINT "the same loop, a different function:", 50, 244
  TEXT_COLOR RGB(200, 214, 232)
  FOR i = 0 TO LEN(numbers) - 1
    PRINT "action(" + STR$(numbers[i]) + ") = " + STR$(action(numbers[i])), 70, 272 + i * 24
  NEXT

  TEXT_COLOR RGB(160, 176, 200)
  PRINT "total(action, numbers) = " + STR$(total(action, numbers)), 50, 408
  PRINT "the callback is a value - store it, pass it, call it by name", 50, 444

  IF KEY_PRESSED(KEY_SPACE) THEN
    which% = which% + 1
    IF which% > 2 THEN which% = 0
    IF which% = 0 THEN
      action = @doubleIt
    ELSEIF which% = 1 THEN
      action = @square
    ELSE
      action = @plus100
    ENDIF
  ENDIF
  IF KEY_PRESSED(KEY_ESC) THEN END

  SCREEN_SHOW
WEND
