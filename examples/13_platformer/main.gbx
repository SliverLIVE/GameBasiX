' ============================================================
' Pip and the Golden Coins - a side-scrolling platformer
' Run: gbx examples/13_platformer/platformer.gbxproj
'
' Arrows / A, D  move        SPACE / W / UP  jump (hold = higher)
' SHIFT / X      run         P  pause        R  restart
' Gamepad 0:    D-pad / left stick  move,  A  jump,  B / left trigger  run,
'               START  pause and play again
' ESC            quit
'
' The level is the block of map$ rows at the bottom: '#' ground,
' 'b' brick, '*' question block, 'u' used block, '=' platform,
' '[]{}' pipe, 'o' coin, 'e' enemy, 'S' start, 'P' goal.
' The engine (physics, collision, level parsing) is in
' platformer.gbx; this file draws and reads the keyboard.
' The atlas and the sounds in assets/ are generated by
' tools/make_platformer_art.py (needs Pillow).
' ============================================================

INCLUDE "platformer.gbx"

CONSTANT SW = 960
CONSTANT SH = 576
CONSTANT HORIZON = 480

' frames in assets/atlas.png (48x48 cells, 8 per row)
CONSTANT F_GROUND_TOP = 0
CONSTANT F_GROUND_FILL = 1
CONSTANT F_BRICK = 2
CONSTANT F_QUESTION = 3
CONSTANT F_USED = 6
CONSTANT F_PLATFORM = 7
CONSTANT F_PIPE_TL = 8
CONSTANT F_PIPE_TR = 9
CONSTANT F_PIPE_BL = 10
CONSTANT F_PIPE_BR = 11
CONSTANT F_POLE = 12
CONSTANT F_FLAG = 13
CONSTANT F_CLOUD_BIG = 14
CONSTANT F_CLOUD_SMALL = 15
CONSTANT F_BUSH_BIG = 16
CONSTANT F_BUSH_SMALL = 17
CONSTANT F_SIGN = 18
CONSTANT F_HEART = 19
CONSTANT F_HERO_IDLE = 20
CONSTANT F_HERO_LEFT = 26
CONSTANT F_FOE_A = 32
CONSTANT F_FOE_SQUASH = 34
CONSTANT F_COIN_1 = 35

CONSTANT SND_JUMP = 1
CONSTANT SND_COIN = 2
CONSTANT SND_STOMP = 3
CONSTANT SND_HURT = 4
CONSTANT SND_BUMP = 5
CONSTANT SND_WIN = 6

SCREEN_SET SW, SH, 0
WINDOW_TITLE "GameBasiX - Pip and the Golden Coins"
LIMIT_FPS 60
SET_SMOOTHING FALSE
SCREEN_CLEAR RGB(88, 156, 232)
FONT_SET FONT_CURRENT(), 2

ANIM_LOAD "assets/atlas.png", 1, 48, 48
SOUND_LOAD "assets/jump.wav", SND_JUMP
SOUND_LOAD "assets/coin.wav", SND_COIN
SOUND_LOAD "assets/stomp.wav", SND_STOMP
SOUND_LOAD "assets/hurt.wav", SND_HURT
SOUND_LOAD "assets/bump.wav", SND_BUMP
SOUND_LOAD "assets/win.wav", SND_WIN

' ---------------------------------------------------------- level
DIM map$[ROWS]
  map$[0] = ""
  map$[1] = ""
  map$[2] = ""
  map$[3] = ""
  map$[4] = ""
  map$[5] = "                                                       ooo"
  map$[6] = "           ooo        ooo                oo bbb              b*bb       oooo                               #"
  map$[7] = "     ooo*  b*b             b*b        bb*bb               *                   b*b ooo *       oo          ##ooo"
  map$[8] = "                []                []                   ===        []  ==          ===   []               ###"
  map$[9] = " TS          e  {} e      e   oooe{}e      e e      e []  e    e  {}e          e    e   {}  e        e e####          P"
  map$[10] = "######################   ######################   ######################    ####################   #############################"
  map$[11] = "######################   ######################   ######################    ####################   #############################"

LEVEL_LOAD()
NEW_GAME()

camX = 0.0
animT = 0.0
paused = 0
hintTime = 7.0


' ---------------------------------------------------------- drawing
FUNCTION TILE_INDEX: ch$
  IF ch$ = "#" THEN RETURN F_GROUND_TOP
  IF ch$ = "b" THEN RETURN F_BRICK
  IF ch$ = "*" THEN RETURN F_QUESTION
  IF ch$ = "u" THEN RETURN F_USED
  IF ch$ = "=" THEN RETURN F_PLATFORM
  IF ch$ = "[" THEN RETURN F_PIPE_TL
  IF ch$ = "]" THEN RETURN F_PIPE_TR
  IF ch$ = "{" THEN RETURN F_PIPE_BL
  IF ch$ = "}" THEN RETURN F_PIPE_BR
  IF ch$ = "T" THEN RETURN F_SIGN
  RETURN -1
ENDFUNCTION

FUNCTION PRINT_SHADOW: text$, x, y, col
  TEXT_COLOR RGB(22, 30, 46)
  PRINT text$, x + 2, y + 2
  TEXT_COLOR col
  PRINT text$, x, y
ENDFUNCTION

FUNCTION PRINT_CENTER: text$, y, col
  PRINT_SHADOW text$, (SW - LEN(text$) * 16) / 2, y, col
ENDFUNCTION

FUNCTION DRAW_SKY:
  FOR i = 0 TO 11
    r = 88 + i * 8
    g = 156 + i * 6
    b = 236 + i
    IF b > 255 THEN b = 255
    DRAW_RECT 0, i * 48, SW, 48, RGB(r, g, b)
  NEXT
  DRAW_CIRCLE_FILLED 686, 128, 40, RGB(255, 240, 178)
  DRAW_CIRCLE_FILLED 686, 128, 31, RGB(255, 250, 214)
ENDFUNCTION

FUNCTION DRAW_HILLS:
  off = MOD(camX * 0.25, 340)
  FOR i = 0 TO 5
    cx = i * 340 - off + 100
    DRAW_CIRCLE_FILLED cx, HORIZON + 46, 152, RGB(122, 198, 110)
  NEXT
  off = MOD(camX * 0.45, 300)
  FOR i = 0 TO 6
    cx = i * 300 - off + 20
    DRAW_CIRCLE_FILLED cx, HORIZON + 76, 128, RGB(96, 176, 92)
  NEXT
ENDFUNCTION

FUNCTION DRAW_CLOUDS:
  off = MOD(camX * 0.35, 480)
  FOR i = 0 TO 3
    cx = i * 480 - off
    ANIM_DRAW 1, F_CLOUD_BIG, cx + 40, 58
    ANIM_DRAW 1, F_CLOUD_SMALL, cx + 252, 128
  NEXT
ENDFUNCTION

FUNCTION DRAW_BUSHES:
  off = MOD(camX * 0.75, 430)
  FOR i = 0 TO 3
    cx = i * 430 - off
    ANIM_DRAW 1, F_BUSH_BIG, cx + 30, HORIZON - 48
    ANIM_DRAW 1, F_BUSH_SMALL, cx + 232, HORIZON - 48
  NEXT
ENDFUNCTION

FUNCTION DRAW_GOAL:
  IF hasGoal = FALSE THEN RETURN 0
  sx = goalX - INTEGER(camX)
  IF sx < -160 OR sx > SW + 160 THEN RETURN 0
  FOR i = 1 TO 5
    ANIM_DRAW 1, F_POLE, sx - 24, goalY - i * TILE
  NEXT
  ANIM_DRAW 1, F_FLAG, sx - 24, goalY - 6 * TILE
  RETURN 0
ENDFUNCTION

FUNCTION DRAW_TILES:
  c0 = FLOOR(camX / TILE)
  IF c0 < 0 THEN c0 = 0
  c1 = c0 + 21
  IF c1 > mapW - 1 THEN c1 = mapW - 1
  shift = INTEGER(camX)
  FOR c = c0 TO c1
    sx = c * TILE - shift
    FOR r = 0 TO ROWS - 1
      t$ = MID$(map$[r], c, 1)
      IF t$ <> " "
        fr = TILE_INDEX(t$)
        IF t$ = "#" AND TILE_AT(c, r - 1) = "#" THEN fr = F_GROUND_FILL
        IF t$ = "*" THEN fr = F_QUESTION + MOD(INTEGER(animT * 6), 3)
        IF fr >= 0 THEN ANIM_DRAW 1, fr, sx, r * TILE
      ENDIF
    NEXT
  NEXT
ENDFUNCTION

FUNCTION DRAW_COINS:
  fr = F_COIN_1 + MOD(INTEGER(animT * 10), 4)
  FOR i = 0 TO coinCount - 1
    IF coins[i].taken = 0
      sx = coins[i].x - INTEGER(camX) - 24
      IF sx > -48 AND sx < SW THEN ANIM_DRAW 1, fr, sx, coins[i].y - 24
    ENDIF
  NEXT
ENDFUNCTION

FUNCTION DRAW_FOES:
  FOR i = 0 TO foeCount - 1
    IF foes[i].alive
      sx = foes[i].x - INTEGER(camX) - 7
      IF sx > -48 AND sx < SW
        sy = foes[i].y - 16
        IF foes[i].squash > 0
          ANIM_DRAW 1, F_FOE_SQUASH, sx, sy
        ELSE
          ANIM_DRAW 1, F_FOE_A + MOD(INTEGER(animT * 7), 2), sx, sy
        ENDIF
      ENDIF
    ENDIF
  NEXT
ENDFUNCTION

FUNCTION DRAW_PLAYER:
  base = F_HERO_IDLE
  IF plFace < 0 THEN base = F_HERO_LEFT
  fr = base
  IF plOnGround = FALSE THEN fr = base + 4
  IF plOnGround AND ABS(pvx) > 15 THEN fr = base + 1 + MOD(INTEGER(animT * (6 + ABS(pvx) / 30)), 3)
  IF plHurt > 0 THEN
    fr = base + 5
    ' blink while invulnerable
    IF MOD(INTEGER(animT * 16), 2) = 0 THEN RETURN 0
  ENDIF
  ANIM_DRAW 1, fr, px - 9 - INTEGER(camX), py - 4
  RETURN 0
ENDFUNCTION

FUNCTION DRAW_HUD:
  ANIM_DRAW 1, F_COIN_1 + MOD(INTEGER(animT * 10), 4), 16, 12
  PRINT_SHADOW "x" + FORMAT$(2, 0, collected), 62, 26, RGB(255, 236, 160)
  PRINT_SHADOW "SCORE " + score, 300, 26, RGB(255, 255, 255)
  PRINT_SHADOW "TIME " + INTEGER(levelTime), 700, 26, RGB(255, 255, 255)
  FOR i = 1 TO lives
    ANIM_DRAW 1, F_HEART, 830 + i * 36 - 36, 12
  NEXT
ENDFUNCTION

FUNCTION DRAW_HINT:
  IF hintTime <= 0 THEN RETURN 0
  PRINT_CENTER "ARROW KEYS OR GAMEPAD MOVE   SPACE / A JUMPS   SHIFT / B RUNS", 74, RGB(236, 246, 255)
  RETURN 0
ENDFUNCTION

FUNCTION DRAW_OVERLAY: title$, note$
  DRAW_RECT 0, 176, SW, 208, RGB(18, 26, 44)
  DRAW_RECT_BORDER 0, 176, SW, 208, RGB(96, 140, 208)
  PRINT_CENTER title$, 204, RGB(255, 226, 140)
  PRINT_CENTER note$, 258, RGB(220, 232, 250)
  PRINT_CENTER "SPACE OR R  PLAY AGAIN", 316, RGB(255, 255, 255)
ENDFUNCTION


' ---------------------------------------------------------- loop
WHILE TRUE
  dt = DELTA_TIME() / 1000.0
  IF dt > 0.05 THEN dt = 0.05
  IF dt < 0 THEN dt = 0
  animT = animT + dt
  IF hintTime > 0 THEN hintTime = hintTime - dt

  IF KEY_PRESSED(KEY_ESC) THEN BREAK

  IF gameOver
    IF KEY_PRESSED(KEY_SPACE) OR KEY_PRESSED(KEY_R) OR JOY_PRESSED(0, JOY_START)
      NEW_GAME()
      camX = 0.0
      hintTime = 0.0
    ENDIF
  ELSEIF levelDone
    IF KEY_PRESSED(KEY_SPACE) OR KEY_PRESSED(KEY_R) OR JOY_PRESSED(0, JOY_START)
      NEW_GAME()
      camX = 0.0
      hintTime = 0.0
    ENDIF
  ELSE
    IF KEY_PRESSED(KEY_P) THEN paused = 1 - paused
    IF JOY_PRESSED(0, JOY_START) THEN paused = 1 - paused
    IF paused = 0
      goLeft = KEY_DOWN(KEY_LEFT) OR KEY_DOWN(KEY_A)
      goRight = KEY_DOWN(KEY_RIGHT) OR KEY_DOWN(KEY_D)
      jumpHeld = KEY_DOWN(KEY_SPACE) OR KEY_DOWN(KEY_UP) OR KEY_DOWN(KEY_W) OR KEY_DOWN(KEY_Z)
      jumpPressed = KEY_PRESSED(KEY_SPACE) OR KEY_PRESSED(KEY_UP) OR KEY_PRESSED(KEY_W) OR KEY_PRESSED(KEY_Z)
      run = KEY_DOWN(KEY_LSHIFT) OR KEY_DOWN(KEY_RSHIFT) OR KEY_DOWN(KEY_X)

      ' Ein Gamepad darf alles, was die Tastatur kann – Pad 0, wenn eins da ist.
      IF JOY_COUNT() > 0
        goLeft = goLeft OR JOY_BUTTON(0, JOY_LEFT) OR JOY_AXIS(0, JOY_AXIS_LX) < -0.4
        goRight = goRight OR JOY_BUTTON(0, JOY_RIGHT) OR JOY_AXIS(0, JOY_AXIS_LX) > 0.4
        jumpHeld = jumpHeld OR JOY_BUTTON(0, JOY_A)
        jumpPressed = jumpPressed OR JOY_PRESSED(0, JOY_A)
        run = run OR JOY_BUTTON(0, JOY_B) OR JOY_AXIS(0, JOY_AXIS_LT) > 0.5
      ENDIF

      PLAYER_UPDATE(dt, goLeft, goRight, jumpHeld, jumpPressed, run)
      FOES_UPDATE(dt)
      PLAYER_HITS(dt)

      IF levelDone = FALSE AND gameOver = FALSE
        levelTime = levelTime - dt
        IF levelTime <= 0
          levelTime = ROUND_TIME
          PLAYER_DIE()
        ENDIF
      ENDIF

      IF KEY_PRESSED(KEY_R)
        LEVEL_RESTART()
        levelTime = ROUND_TIME
        hintTime = 0.0
      ENDIF
    ENDIF
  ENDIF

  ' -------------------------------------------------- sound
  IF sfx = SFX_JUMP THEN SOUND_PLAY SND_JUMP, 0, 0.45
  IF sfx = SFX_COIN THEN SOUND_PLAY SND_COIN, 0, 0.5
  IF sfx = SFX_STOMP THEN SOUND_PLAY SND_STOMP, 0, 0.55
  IF sfx = SFX_HURT THEN SOUND_PLAY SND_HURT, 0, 0.6
  IF sfx = SFX_BUMP THEN SOUND_PLAY SND_BUMP, 0, 0.5
  IF sfx = SFX_WIN THEN SOUND_PLAY SND_WIN, 0, 0.6
  sfx = SFX_NONE

  ' -------------------------------------------------- camera
  targetCam = px + PW / 2 - SW / 2
  maxCam = mapW * TILE - SW
  IF targetCam < 0 THEN targetCam = 0
  IF targetCam > maxCam THEN targetCam = maxCam
  IF gameOver OR levelDone
    targetCam = camX
  ENDIF
  camX = camX + (targetCam - camX) * MIN(1, dt * 9)
  IF camX < 0 THEN camX = 0
  IF camX > maxCam THEN camX = maxCam

  ' -------------------------------------------------- frame
  DRAW_SKY()
  DRAW_CLOUDS()
  DRAW_HILLS()
  DRAW_BUSHES()
  DRAW_GOAL()
  DRAW_TILES()
  DRAW_COINS()
  DRAW_FOES()
  DRAW_PLAYER()
  DRAW_HUD()
  DRAW_HINT()

  IF gameOver
    DRAW_OVERLAY "GAME OVER", "SCORE " + score + "   COINS " + collected
  ELSEIF levelDone
    DRAW_OVERLAY "ROUND CLEAR", "SCORE " + score + "   COINS " + collected
  ELSEIF paused = 1
    DRAW_OVERLAY "PAUSED", "PRESS P TO CONTINUE"
  ENDIF

  SCREEN_SHOW
WEND

END
