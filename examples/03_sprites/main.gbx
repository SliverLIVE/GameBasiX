' ============================================================
' Sprites, rotation/scaling and animations
' Run: gbx examples/03_sprites/sprites.gbxproj
' ============================================================
GLOBAL Ball = 0       
GLOBAL Sparkle = 1

SCREEN_SET 900, 600, 0
WINDOW_TITLE "GameBasiX - Sprites"
LIMIT_FPS 60
SCREEN_CLEAR RGB(6, 8, 14)
SET_SMOOTHING TRUE

SPRITE_LOAD "assets/ball.png", Ball
ANIM_LOAD "assets/sparkle.png", Sparkle, 32, 32

WHILE TRUE
  t = ELAPSED_TIME() / 1000.0

  SCREEN_CLEAR RGB(6, 8, 14)

  ' ring of rotating, pulsing balls
  FOR i = 0 TO 24
    ang = t * 60 + i * 15
    x = 450 + COS(ang) * (70 + i * 11) - 32
    y = 290 + SIN(ang * 1.3) * (60 + i * 7) - 32
    zoom = 35 + 65 * (0.5 + 0.5 * SIN(ang * 0.5))
    SPRITE_DRAW_ROTATED_SCALED Ball, x, y, ang * 2, zoom
  NEXT

  ' animation strip along the bottom edge
  FOR i = 0 TO 15
    frame = MOD(INTEGER(t * 10)+i, 4)
    ANIM_DRAW Sparkle, frame, 70 + i * 50, 520
  NEXT

  TEXT_COLOR RGB(255, 0, 0)
  PRINT "SPRITE_LOAD + SPRITE_DRAW_ROTATED_SCALED and ANIM_LOAD + ANIM_DRAW", 60, 40
  TEXT_COLOR RGB(9, 93, 219)
  PRINT "ESC quits the program", 60, 66
  
  SCREEN_SHOW
WEND
