' ============================================================
' BOX2D-LITE: embedding a third-party C++ library in GBX
' Run: gbx examples/08_box2d/box2d.gbxproj
'
' The INLINE block at the top includes box2d_gbx.h. It contains
' Box2D-Lite (Erin Catto, MIT license) plus a small wrapper.
' There are two ways into the library:
'
'   1. registered commands such as PHYSICS_BOX() and PHYSICS_STEP()
'      - usable in any FUNCTION, without INLINE.
'   2. C++ functions such as gbxbox2d::x() directly in an INLINE
'      step - here in the METHOD draw(), together with POLY_POINT.
'
' BASIC handles setup and input, C++ handles physics and drawing
' the rotated corners. Each box is a textured polygon: one shared
' crate texture, tinted by the per-box vertex color. T toggles it.
' ============================================================

INLINE
#include "box2d_gbx.h"
ENDINLINE

SET_SYSTEM_POINTER TRUE 
SCREEN_SET 960, 640, 0
WINDOW_TITLE "GameBasiX - Box2D-Lite"
LIMIT_FPS 60

' One crate texture, tinted per body by the vertex color below.
GLOBAL Crate = 1
GLOBAL UseTexture = 1
SPRITE_LOAD "assets/crate.png", Crate

CONSTANT GROUND_Y = 630

TYPE BOX
  id AS INTEGER
  color AS INTEGER

  ' Center and rotation come straight from the physics world. The four
  ' corners are rotated in C++ and drawn as a filled polygon.
  METHOD draw
    INLINE
      const int index = static_cast<int>(id);
      const double px = gbxbox2d::x(index);
      const double py = gbxbox2d::y(index);
      const double a = gbxbox2d::angle(index);
      const double hw = gbxbox2d::halfWidth(index);
      const double hh = gbxbox2d::halfHeight(index);
      const double c = std::cos(a);
      const double s = std::sin(a);

      auto corner = [&](double ex, double ey, double& ox, double& oy) {
          ox = px + c * ex - s * ey;
          oy = py + s * ex + c * ey;
      };

      double x1, y1, x2, y2, x3, y3, x4, y4;
      corner(-hw, -hh, x1, y1);
      corner( hw, -hh, x2, y2);
      corner( hw,  hh, x3, y3);
      corner(-hw,  hh, x4, y4);

      if (usetexture.value() > 0.5) {
          /* Normalized texture coordinates: 0,0 is the top left of the
           * sprite, 1,1 the bottom right. The vertex color tints it. */
          POLY_BEGIN(crate);
          POLY_POINT(x1, y1, 0.0, 0.0, color);
          POLY_POINT(x2, y2, 1.0, 0.0, color);
          POLY_POINT(x3, y3, 1.0, 1.0, color);
          POLY_POINT(x4, y4, 0.0, 1.0, color);
          POLY_END();
      } else {
          POLY_BEGIN();
          POLY_POINT(x1, y1, 0, 0, color);
          POLY_POINT(x2, y2, 0, 0, color);
          POLY_POINT(x3, y3, 0, 0, color);
          POLY_POINT(x4, y4, 0, 0, color);
          POLY_END();
      }

      DRAW_LINE(x1, y1, x2, y2, 0x0E1420);
      DRAW_LINE(x2, y2, x3, y3, 0x0E1420);
      DRAW_LINE(x3, y3, x4, y4, 0x0E1420);
      DRAW_LINE(x4, y4, x1, y1, 0x0E1420);
    ENDINLINE
  ENDMETHOD
ENDTYPE

DIM boxes[0] AS BOX

GLOBAL ColorIndex = 0
GLOBAL CurrentBox AS BOX

FUNCTION RandomColor:
  ColorIndex = ColorIndex + 1
  IF MOD(ColorIndex, 3) = 0 THEN RETURN RGB(255, 158, 96)
  IF MOD(ColorIndex, 3) = 1 THEN RETURN RGB(96, 196, 255)
  RETURN RGB(150, 226, 150)
ENDFUNCTION

' The normal way: BASIC creates a body, C++ stores it. PHYSICS_BOX
' returns the ID, and the BASIC record keeps the ID and its color.
FUNCTION NewBox: x, y, width, height, angle, isStatic, color
  LOCAL box AS BOX
  box.id = PHYSICS_BOX(x, y, width, height, angle, isStatic, color)
  box.color = color
  DIMPUSH boxes[], box
  RETURN box.id
ENDFUNCTION

FUNCTION Tower: x, y, count, width, height
  FOR i = 0 TO count - 1
    NewBox(x, y - i * (height + 8), width, height, 0, 0, RandomColor())
  NEXT
  RETURN count
ENDFUNCTION

FUNCTION Rebuild:
  PHYSICS_RESET()
  REDIM boxes[0] AS BOX
  NewBox(480, 596, 90, 56, 0, 0, RandomColor())
  Tower(300, 590, 5, 70, 50)
  Tower(660, 590, 5, 70, 50)
  ' A static ramp in the middle: shows rotation and collision.
  NewBox(480, 500, 280, 20, -0.15, 1, RGB(120, 130, 150))
  ' A dynamic box resting on the ramp; it slides down on its own.
  NewBox(430, 470, 46, 34, -0.15, 0, RandomColor())
  RETURN 0
ENDFUNCTION

Rebuild()

WHILE TRUE
  IF KEY_PRESSED(KEY_ESC) THEN END
  IF KEY_PRESSED(KEY_R) THEN Rebuild()
  IF KEY_PRESSED(KEY_T) THEN UseTexture = 1 - UseTexture

  IF KEY_PRESSED(KEY_SPACE)
    FOR n = 0 TO 7
      NewBox(300 + n * 48, 80 + MOD(n, 2) * 40, 36, 36, RND(314) / 100.0, 0, RandomColor())
    NEXT
  ENDIF

  IF MOUSE_PRESSED(1)
    NewBox(MOUSE_AXIS(0), MOUSE_AXIS(1), 30 + RND(30), 30 + RND(30), RND(314) / 100.0, 0, RandomColor())
  ENDIF

  ' Fixed step: the simulation always runs at 60 Hz, even if a frame
  ' takes longer. The wrapper clamps dt as well.
  PHYSICS_STEP(1.0 / 60.0)

  SCREEN_CLEAR RGB(10, 13, 20)
  DRAW_RECT 0, GROUND_Y, 960, 10, RGB(34, 43, 60)
  DRAW_RECT 0, GROUND_Y - 2, 960, 2, RGB(70, 90, 120)

  FOR i = 0 TO ARRAY_BOUNDS(boxes[], 0) - 1
    CurrentBox = boxes[i]
    CurrentBox.draw()
  NEXT

  TEXT_COLOR RGB(130, 205, 255)
  PRINT "BOX2D-LITE", 24, 18
  TEXT_COLOR RGB(140, 150, 168)
  PRINT "C++ library embedded via INLINE - " + STR$(PHYSICS_COUNT() - 1) + " bodies", 24, 40
  PRINT "Click: box   SPACE: row   R: reset   T: texture   ESC: quit", 24, 62

  SCREEN_SHOW
WEND

