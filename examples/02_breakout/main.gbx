' ============================================================
' Breakout - playable example
' Mouse or arrow keys, SPACE to restart, ESC quits
' ============================================================

SCREEN_SET 900, 640, 0
LIMIT_FPS 60
SCREEN_CLEAR RGB(8, 10, 18)
SET_SYSTEM_POINTER FALSE

CONSTANT COLS = 12
CONSTANT ROWS = 6
CONSTANT BRICKW = 66
CONSTANT BRICKH = 22
CONSTANT PADDLEW = 130

DIM bricks[COLS][ROWS]

score = 0
lives = 3
running = TRUE
lastMx = -1
paddleX = 385
ballX = 450.0
ballY = 520.0
ballR = 9.0
velX = 3.6
velY = -4.8

FUNCTION newRound
  FOR cx = 0 TO COLS - 1
    FOR cy = 0 TO ROWS - 1
      bricks[cx][cy] = 1
    NEXT
  NEXT
ENDFUNCTION

FUNCTION resetBall
  ballX = 450
  ballY = 520
  velX = 3.6
  velY = -4.8
  paddleX = 450 - PADDLEW / 2
ENDFUNCTION

FUNCTION drawHud
  TEXT_COLOR RGB(200, 220, 255)
  PRINT "Score: " + score, 30, 20
  PRINT "Lives: " + lives, 780, 20
  IF running = FALSE
    TEXT_COLOR RGB(255, 230, 150)
    PRINT "Game over - SPACE to restart", 250, 300
  ENDIF
ENDFUNCTION

newRound()
resetBall()

WHILE TRUE
  ' ------------------------------------------------ Input
  IF KEY_DOWN(KEY_LEFT) THEN paddleX = paddleX - 9
  IF KEY_DOWN(KEY_RIGHT) THEN paddleX = paddleX + 9

  MOUSE_STATE mx, my, mb1, mb2
  IF mx <> lastMx
    paddleX = mx - PADDLEW / 2
    lastMx = mx
  ENDIF
  paddleX = MAX(0, MIN(900 - PADDLEW, paddleX))

  ' ------------------------------------------------ Logic
  IF running
    ballX = ballX + velX
    ballY = ballY + velY

    IF ballX < ballR
      ballX = ballR
      velX = ABS(velX)
    ENDIF
    IF ballX > 900 - ballR
      ballX = 900 - ballR
      velX = -ABS(velX)
    ENDIF
    IF ballY < 40 + ballR
      ballY = 40 + ballR
      velY = ABS(velY)
    ENDIF

    ' Paddle: the ball bounces off, direction depends on the hit point
    IF velY > 0 AND ballY + ballR > 585 AND ballY - ballR < 605
      IF ballX > paddleX - ballR AND ballX < paddleX + PADDLEW + ballR
        ballY = 585 - ballR
        velY = -ABS(velY)
        velX = velX + (ballX - (paddleX + PADDLEW / 2)) / 28
        velX = MAX(-9, MIN(9, velX))
      ENDIF
    ENDIF

    ' Bricks
    FOR cx = 0 TO COLS - 1
      FOR cy = 0 TO ROWS - 1
        IF bricks[cx][cy] = 1
          bx = 60 + cx * (BRICKW + 2)
          by = 70 + cy * (BRICKH + 4)
          IF RECT_COLLIDE(ballX - ballR, ballY - ballR, ballR * 2, ballR * 2, bx, by, BRICKW, BRICKH)
            bricks[cx][cy] = 0
            score = score + 10
            velY = -velY
          ENDIF
        ENDIF
      NEXT
    NEXT

    ' Ball below the bottom edge
    IF ballY > 640 + ballR
      DEC lives
      IF lives <= 0
        running = FALSE
      ELSE
        resetBall()
      ENDIF
    ENDIF
  ELSE
    IF KEY_PRESSED(KEY_SPACE)
      score = 0
      lives = 3
      newRound()
      resetBall()
      running = TRUE
    ENDIF
  ENDIF

  ' ------------------------------------------------ Drawing
  SCREEN_CLEAR RGB(8, 10, 18)

  FOR cx = 0 TO COLS - 1
    FOR cy = 0 TO ROWS - 1
      IF bricks[cx][cy] = 1
        bx = 60 + cx * (BRICKW + 2)
        by = 70 + cy * (BRICKH + 4)
        col = RGB(90 + cy * 22, 170 - cy * 14, 255 - cy * 20)
        DRAW_RECT bx, by, BRICKW, BRICKH, col
        DRAW_RECT bx + 3, by + 3, BRICKW - 6, 4, RGB(255, 255, 255)
      ENDIF
    NEXT
  NEXT

  DRAW_RECT paddleX, 585, PADDLEW, 16, RGB(120, 200, 255)
  DRAW_RECT paddleX + 4, 588, PADDLEW - 8, 4, RGB(220, 245, 255)

  DRAW_CIRCLE_FILLED ballX, ballY, ballR, RGB(255, 220, 120)
  DRAW_CIRCLE_FILLED ballX - 3, ballY - 3, ballR / 2, RGB(255, 250, 220)

  drawHud()
  SCREEN_SHOW
WEND
